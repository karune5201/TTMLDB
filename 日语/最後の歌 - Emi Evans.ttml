                <span begin="00:00:44.345" end="00:00:45.833"> </span>
                <span begin="00:00:45.833" end="00:00:46.921">あ</span>
                <span begin="00:00:46.921" end="00:00:49.154">る</span>
                <span begin="00:00:49.154" end="00:00:49.953"> </span>
                <span begin="00:00:49.953" end="00:00:50.937">ま</span>
