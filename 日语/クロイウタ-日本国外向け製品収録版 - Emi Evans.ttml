  <body>
    <div>
      <p begin="00:00:26.285" end="00:00:36.827"><span begin="00:00:26.285" end="00:00:27.012">ア</span><span begin="00:00:27.012" end="00:00:27.716">タ</span><span begin="00:00:27.716" end="00:00:28.413">ラ</span><span begin="00:00:28.413" end="00:00:29.165">セ</span><span begin="00:00:29.165" end="00:00:29.165"> </span><span begin="00:00:29.165" end="00:00:30.774">リ</span><span begin="00:00:30.774" end="00:00:31.568"> </span><span begin="00:00:31.568" end="00:00:32.209">ハ</span><span begin="00:00:32.209" end="00:00:32.944">メ</span><span begin="00:00:32.944" end="00:00:33.680">ツ</span><span begin="00:00:33.680" end="00:00:34.465">ア</span><span begin="00:00:34.465" end="00:00:35.200">ウ</span><span begin="00:00:35.200" end="00:00:35.200"> </span><span begin="00:00:35.200" end="00:00:36.827">タ</span><span ttm:role="x-translation">残惜之争  破灭的歌</span></p>
      <p begin="00:00:38.224" end="00:00:49.237"><span begin="00:00:38.224" end="00:00:38.968">ケ</span><span begin="00:00:38.968" end="00:00:39.655">モ</span><span begin="00:00:39.655" end="00:00:40.403">ノ</span><span begin="00:00:40.403" end="00:00:41.120">ト</span><span begin="00:00:41.120" end="00:00:41.120"> </span><span begin="00:00:41.120" end="00:00:41.985">ナ</span><span begin="00:00:41.985" end="00:00:42.741">リ</span><span begin="00:00:42.741" end="00:00:43.581"> </span><span begin="00:00:43.581" end="00:00:44.293">ト</span><span begin="00:00:44.293" end="00:00:45.789">キ</span><span begin="00:00:45.789" end="00:00:49.237">リ</span><span ttm:role="x-translation">只要以兽为邻</span></p>
      <p begin="00:00:50.157" end="00:01:00.857"><span begin="00:00:50.157" end="00:00:50.861">ウ</span><span begin="00:00:50.861" end="00:00:51.597">バ</span><span begin="00:00:51.597" end="00:00:52.349">イ</span><span begin="00:00:52.349" end="00:00:53.103">サ</span><span begin="00:00:53.103" end="00:00:53.103"> </span><span begin="00:00:53.103" end="00:00:54.769">ル</span><span begin="00:00:54.769" end="00:00:55.377"> </span><span begin="00:00:55.377" end="00:00:56.081">ハ</span><span begin="00:00:56.081" end="00:00:56.881">リ</span><span begin="00:00:56.881" end="00:00:57.625">ノ</span><span begin="00:00:57.625" end="00:00:58.371">シ</span><span begin="00:00:58.371" end="00:00:59.124">ラ</span><span begin="00:00:59.124" end="00:00:59.124"> </span><span begin="00:00:59.124" end="00:01:00.857">ベ</span><span ttm:role="x-translation">被夺走的脆弱声音</span></p>
      <p begin="00:01:02.121" end="00:01:11.103"><span begin="00:01:02.121" end="00:01:02.885">リ</span><span begin="00:01:02.885" end="00:01:03.649">ン</span><span begin="00:01:03.649" end="00:01:04.489">ネ</span><span begin="00:01:04.489" end="00:01:05.170">ノ</span><span begin="00:01:05.170" end="00:01:05.170"> </span><span begin="00:01:05.170" end="00:01:05.793">ヒ</span><span begin="00:01:05.793" end="00:01:06.940">ト</span><span begin="00:01:06.940" end="00:01:07.515"> </span><span begin="00:01:07.515" end="00:01:08.267">タ</span><span begin="00:01:08.267" end="00:01:11.103">リ</span><span ttm:role="x-translation">就会反复不止</span></p>
      <p begin="00:01:13.467" end="00:01:18.752"><span begin="00:01:13.467" end="00:01:14.207">シ</span><span begin="00:01:14.207" end="00:01:14.945">ト</span><span begin="00:01:14.945" end="00:01:15.296"> </span><span begin="00:01:15.296" end="00:01:15.649">ハ</span><span begin="00:01:15.649" end="00:01:16.081">バ</span><span begin="00:01:16.081" end="00:01:16.378">タ</span><span begin="00:01:16.378" end="00:01:16.785">ツ</span><span begin="00:01:16.785" end="00:01:17.281">ア</span><span begin="00:01:17.281" end="00:01:18.752">ミ</span><span ttm:role="x-translation">死亡编织的巨网</span></p>
      <p begin="00:01:19.457" end="00:01:24.836"><span begin="00:01:19.457" end="00:01:20.208">コ</span><span begin="00:01:20.208" end="00:01:20.884">イ</span><span begin="00:01:20.884" end="00:01:21.278"> </span><span begin="00:01:21.278" end="00:01:21.623">ク</span><span begin="00:01:21.623" end="00:01:22.108">ラ</span><span begin="00:01:22.108" end="00:01:22.396">イ</span><span begin="00:01:22.396" end="00:01:22.708">シ</span><span begin="00:01:22.708" end="00:01:23.227">ロ</span><span begin="00:01:23.227" end="00:01:23.956">カ</span><span begin="00:01:23.956" end="00:01:24.836">ラ</span><span ttm:role="x-translation">笼罩着整个城</span></p>
      <p begin="00:01:25.437" end="00:01:31.205"><span begin="00:01:25.437" end="00:01:26.180">イ</span><span begin="00:01:26.180" end="00:01:27.220">ツ</span><span begin="00:01:27.220" end="00:01:27.220"> </span><span begin="00:01:27.220" end="00:01:27.636">オ</span><span begin="00:01:27.636" end="00:01:28.030">ア</span><span begin="00:01:28.030" end="00:01:28.030"> </span><span begin="00:01:28.030" end="00:01:28.232">ト</span><span begin="00:01:28.232" end="00:01:28.670">オ</span><span begin="00:01:28.670" end="00:01:29.046">ク</span><span begin="00:01:29.046" end="00:01:29.046"> </span><span begin="00:01:29.046" end="00:01:30.167">キ</span><span begin="00:01:30.167" end="00:01:30.558">コ</span><span begin="00:01:30.558" end="00:01:31.205">エ</span><span ttm:role="x-translation">何时 可以听到 远处</span></p>
      <p begin="00:01:31.350" end="00:01:40.598"><span begin="00:01:31.350" end="00:01:31.510">ア</span><span begin="00:01:31.510" end="00:01:31.798">マ</span><span begin="00:01:31.798" end="00:01:32.183">イ</span><span begin="00:01:32.183" end="00:01:32.183"> </span><span begin="00:01:32.183" end="00:01:32.854">キ</span><span begin="00:01:32.854" end="00:01:33.638">ロ</span><span begin="00:01:33.638" end="00:01:34.326">ク</span><span begin="00:01:34.326" end="00:01:35.167">バ</span><span begin="00:01:35.167" end="00:01:36.638">ネ</span><span begin="00:01:36.638" end="00:01:37.038"> </span><span begin="00:01:37.038" end="00:01:37.414">サ</span><span begin="00:01:37.414" end="00:01:37.782">サ</span><span begin="00:01:37.782" end="00:01:38.342">メ</span><span begin="00:01:38.342" end="00:01:40.598">ク</span><span ttm:role="x-translation">乘着翅膀而来的绝美话语</span></p>
      <p begin="00:01:41.166" end="00:01:52.403"><span begin="00:01:41.166" end="00:01:42.022">ク</span><span begin="00:01:42.022" end="00:01:42.605">ロ</span><span begin="00:01:42.605" end="00:01:43.358">イ</span><span begin="00:01:43.358" end="00:01:44.256">ハ</span><span begin="00:01:44.256" end="00:01:46.418">ナ</span><span begin="00:01:46.418" end="00:01:47.137"> </span><span begin="00:01:47.137" end="00:01:47.873">ア</span><span begin="00:01:47.873" end="00:01:48.624">ノ</span><span begin="00:01:48.624" end="00:01:49.352">コ</span><span begin="00:01:49.352" end="00:01:50.144">エ</span><span begin="00:01:50.144" end="00:01:52.403">ガ</span><span ttm:role="x-translation">黑色的花呀 仿佛被破坏了一般</span></p>
      <p begin="00:01:53.160" end="00:02:04.513"><span begin="00:01:53.160" end="00:01:53.944">コ</span><span begin="00:01:53.944" end="00:01:54.611">ワ</span><span begin="00:01:54.611" end="00:01:55.336">レ</span><span begin="00:01:55.336" end="00:01:56.147">タ</span><span begin="00:01:56.147" end="00:01:56.825">メ</span><span begin="00:01:56.825" end="00:01:58.155">ノ</span><span begin="00:01:58.155" end="00:01:58.504"> </span><span begin="00:01:58.504" end="00:01:59.129">ア</span><span begin="00:01:59.129" end="00:02:01.007">ル</span><span begin="00:02:01.007" end="00:02:01.429"> </span><span begin="00:02:01.429" end="00:02:02.145">マ</span><span begin="00:02:02.145" end="00:02:04.513">マ</span><span ttm:role="x-translation">终究成全不了</span></p>
      <p begin="00:02:05.159" end="00:02:16.524"><span begin="00:02:05.159" end="00:02:05.856">ク</span><span begin="00:02:05.856" end="00:02:06.624">ロ</span><span begin="00:02:06.624" end="00:02:07.346">イ</span><span begin="00:02:07.346" end="00:02:08.255">ハ</span><span begin="00:02:08.255" end="00:02:10.867">ナ</span><span begin="00:02:10.867" end="00:02:11.258"> </span><span begin="00:02:11.258" end="00:02:11.876">ア</span><span begin="00:02:11.876" end="00:02:12.563">ノ</span><span begin="00:02:12.563" end="00:02:13.467">ウ</span><span begin="00:02:13.467" end="00:02:14.093">タ</span><span begin="00:02:14.093" end="00:02:16.524">ガ</span><span ttm:role="x-translation">残惜之争 冰冻的歌</span></p>
      <p begin="00:02:17.178" end="00:02:27.939"><span begin="00:02:17.178" end="00:02:17.923">ツ</span><span begin="00:02:17.923" end="00:02:18.636">ク</span><span begin="00:02:18.636" end="00:02:19.532">リ</span><span begin="00:02:19.532" end="00:02:20.171">マ</span><span begin="00:02:20.171" end="00:02:20.827">イ</span><span begin="00:02:20.827" end="00:02:22.460">ツ</span><span begin="00:02:22.460" end="00:02:22.460"> </span><span begin="00:02:22.460" end="00:02:23.115">ア</span><span begin="00:02:23.115" end="00:02:25.531">ル</span><span begin="00:02:25.531" end="00:02:25.531"> </span><span begin="00:02:25.531" end="00:02:26.155">マ</span><span begin="00:02:26.155" end="00:02:27.939">マ</span><span ttm:role="x-translation">只有把这噩梦充斥的日子</span></p>
      <p begin="00:02:28.404" end="00:02:32.563"><span begin="00:02:28.404" end="00:02:29.803">イ</span><span begin="00:02:29.803" end="00:02:32.563">ミ</span><span ttm:role="x-translation">斩除</span></p>
      <p begin="00:02:47.445" end="00:02:58.369"><span begin="00:02:47.445" end="00:02:47.953">ア</span><span begin="00:02:47.953" end="00:02:48.588">タ</span><span begin="00:02:48.588" end="00:02:49.324">ラ</span><span begin="00:02:49.324" end="00:02:50.131">セ</span><span begin="00:02:50.131" end="00:02:50.131"> </span><span begin="00:02:50.131" end="00:02:51.926">リ</span><span begin="00:02:51.926" end="00:02:52.366"> </span><span begin="00:02:52.366" end="00:02:52.824">コ</span><span begin="00:02:52.824" end="00:02:53.817">オ</span><span begin="00:02:53.817" end="00:02:54.561">リ</span><span begin="00:02:54.561" end="00:02:55.281">ア</span><span begin="00:02:55.281" end="00:02:56.105">ウ</span><span begin="00:02:56.105" end="00:02:56.105"> </span><span begin="00:02:56.105" end="00:02:58.369">タ</span><span ttm:role="x-translation">走吧 从红色之森开始</span></p>
      <p begin="00:02:59.097" end="00:03:08.585"><span begin="00:02:59.097" end="00:02:59.768">ア</span><span begin="00:02:59.768" end="00:03:00.554">ク</span><span begin="00:03:00.554" end="00:03:01.289">ム</span><span begin="00:03:01.289" end="00:03:02.097">ナ</span><span begin="00:03:02.097" end="00:03:02.097"> </span><span begin="00:03:02.097" end="00:03:02.881">マ</span><span begin="00:03:02.881" end="00:03:04.338">ウ</span><span begin="00:03:04.338" end="00:03:04.338"> </span><span begin="00:03:04.338" end="00:03:05.081">ヒ</span><span begin="00:03:05.081" end="00:03:08.585">ヲ</span><span ttm:role="x-translation">本应避及的 却酝酿着污浊</span></p>
      <p begin="00:03:10.481" end="00:03:15.744"><span begin="00:03:10.481" end="00:03:11.154">ム</span><span begin="00:03:11.154" end="00:03:12.241">ト</span><span begin="00:03:12.241" end="00:03:12.241"> </span><span begin="00:03:12.241" end="00:03:12.585">タ</span><span begin="00:03:12.585" end="00:03:13.041">チ</span><span begin="00:03:13.041" end="00:03:13.329">キ</span><span begin="00:03:13.329" end="00:03:13.691">ル</span><span begin="00:03:13.691" end="00:03:14.145">シ</span><span begin="00:03:14.145" end="00:03:15.744">ガ</span><span ttm:role="x-translation">小小的思绪也被没收</span></p>
      <p begin="00:03:16.433" end="00:03:21.969"><span begin="00:03:16.433" end="00:03:17.106">イ</span><span begin="00:03:17.106" end="00:03:18.225">ク</span><span begin="00:03:18.225" end="00:03:18.225"> </span><span begin="00:03:18.225" end="00:03:18.537">ア</span><span begin="00:03:18.537" end="00:03:18.881">カ</span><span begin="00:03:18.881" end="00:03:19.273">イ</span><span begin="00:03:19.273" end="00:03:19.657">モ</span><span begin="00:03:19.657" end="00:03:20.121">リ</span><span begin="00:03:20.121" end="00:03:20.937">カ</span><span begin="00:03:20.937" end="00:03:21.969">ラ</span><span ttm:role="x-translation">黑色的花呀</span></p>
