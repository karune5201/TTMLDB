      <p begin="00:04:14.122" end="00:04:24.861"><span begin="00:04:14.122" end="00:04:14.850">ザ</span><span begin="00:04:14.850" end="00:04:15.578">ン</span><span begin="00:04:15.578" end="00:04:16.258">ゲ</span><span begin="00:04:16.258" end="00:04:17.106">ノ</span><span begin="00:04:17.106" end="00:04:17.915">ヒ</span><span begin="00:04:17.915" end="00:04:19.354">ガ</span><span begin="00:04:19.354" end="00:04:19.354"> </span><span begin="00:04:19.354" end="00:04:20.132">ア</span><span begin="00:04:20.132" end="00:04:22.013">ル</span><span begin="00:04:22.013" end="00:04:22.397"> </span><span begin="00:04:22.397" end="00:04:23.092">マ</span><span begin="00:04:23.092" end="00:04:24.861">マ</span><span ttm:role="x-translation">带着忏悔</span></p>
      <p begin="00:04:25.374" end="00:04:30.757"><span begin="00:04:25.374" end="00:04:26.076">キ</span><span begin="00:04:26.076" end="00:04:30.757">エ</span><span ttm:role="x-translation">消失</span></p>
      <p begin="00:04:32.175" end="00:04:43.402"><span begin="00:04:32.175" end="00:04:32.836">サ</span><span begin="00:04:32.836" end="00:04:33.692">イ</span><span begin="00:04:33.692" end="00:04:34.332">ヤ</span><span begin="00:04:34.332" end="00:04:35.286">ク</span><span begin="00:04:35.286" end="00:04:37.675">ア</span><span begin="00:04:37.675" end="00:04:38.118"> </span><span begin="00:04:38.118" end="00:04:38.873">マ</span><span begin="00:04:38.873" end="00:04:39.649">チ</span><span begin="00:04:39.649" end="00:04:40.369">オ</span><span begin="00:04:40.369" end="00:04:41.241">リ</span><span begin="00:04:41.241" end="00:04:43.402">ル</span><span ttm:role="x-translation">厄运降临在这城邦</span></p>
      <p begin="00:04:44.193" end="00:04:55.338"><span begin="00:04:44.193" end="00:04:44.906">コ</span><span begin="00:04:44.906" end="00:04:45.689">ワ</span><span begin="00:04:45.689" end="00:04:46.322">レ</span><span begin="00:04:46.322" end="00:04:47.084">タ</span><span begin="00:04:47.084" end="00:04:47.875">ト</span><span begin="00:04:47.875" end="00:04:49.394">キ</span><span begin="00:04:49.394" end="00:04:49.394"> </span><span begin="00:04:49.394" end="00:04:50.218">ヒ</span><span begin="00:04:50.218" end="00:04:52.337">ト</span><span begin="00:04:52.337" end="00:04:52.337"> </span><span begin="00:04:52.337" end="00:04:53.178">ユ</span><span begin="00:04:53.178" end="00:04:55.338">メ</span><span ttm:role="x-translation">毁灭之时 太阳与梦</span></p>
      <p begin="00:04:56.193" end="00:05:07.334"><span begin="00:04:56.193" end="00:04:56.930">ク</span><span begin="00:04:56.930" end="00:04:57.617">リ</span><span begin="00:04:57.617" end="00:04:58.385">カ</span><span begin="00:04:58.385" end="00:04:59.185">エ</span><span begin="00:04:59.185" end="00:05:01.316">リ</span><span begin="00:05:01.316" end="00:05:02.044"> </span><span begin="00:05:02.044" end="00:05:02.796">ワ</span><span begin="00:05:02.796" end="00:05:03.524">カ</span><span begin="00:05:03.524" end="00:05:04.364">レ</span><span begin="00:05:04.364" end="00:05:05.196">ユ</span><span begin="00:05:05.196" end="00:05:07.334">キ</span><span ttm:role="x-translation">反复着反复着 离别的雪</span></p>
      <p begin="00:05:08.093" end="00:05:18.692"><span begin="00:05:08.093" end="00:05:08.819">ユ</span><span begin="00:05:08.819" end="00:05:09.564">ル</span><span begin="00:05:09.564" end="00:05:10.363">サ</span><span begin="00:05:10.363" end="00:05:11.092">レ</span><span begin="00:05:11.092" end="00:05:11.900">ザ</span><span begin="00:05:11.900" end="00:05:12.939">ル</span><span begin="00:05:12.939" end="00:05:13.410"> </span><span begin="00:05:13.410" end="00:05:14.114">オ</span><span begin="00:05:14.114" end="00:05:16.400">ト</span><span begin="00:05:16.400" end="00:05:16.400"> </span><span begin="00:05:16.400" end="00:05:17.018">ハ</span><span begin="00:05:17.018" end="00:05:18.692">ナ</span><span ttm:role="x-translation">不被原谅的声音</span></p>
