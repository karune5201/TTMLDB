                <span begin="03:48.951" end="03:49.383">せ</span>
                <span begin="03:49.383" end="03:49.861">に</span>
                <span begin="03:49.861" end="03:50.077">い</span>
                <span begin="03:50.077" end="03:50.501">こ</span>
                <span begin="03:50.501" end="03:50.925">う</span>
                <span begin="03:50.925" end="03:51.477">よ</span>
                <span ttm:role="x-translation" xml:lang="zh-CN">携手共进吧</span>
            </p>
        </div>
    </body>
</tt>
