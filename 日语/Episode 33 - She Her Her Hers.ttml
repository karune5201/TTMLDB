<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/itunes/ttml">
  <body>
    <div>
      <p begin="00:00:22.532" end="00:00:27.582"><span begin="00:00:22.532" end="00:00:23.116">感</span><span begin="00:00:23.116" end="00:00:23.508">じ</span><span begin="00:00:23.508" end="00:00:23.741">て</span><span begin="00:00:23.741" end="00:00:24.092"> </span><span begin="00:00:24.092" end="00:00:24.396">今</span><span begin="00:00:24.396" end="00:00:24.668">夜</span><span begin="00:00:24.668" end="00:00:25.117">は</span><span begin="00:00:25.117" end="00:00:25.524">見</span><span begin="00:00:25.524" end="00:00:26.172">事</span><span begin="00:00:26.172" end="00:00:27.582">さ</span><span ttm:role="x-translation">用心感受的今夜 旖旎非常</span></p>
      <p begin="00:00:27.583" end="00:00:31.300"><span begin="00:00:27.583" end="00:00:27.743">見</span><span begin="00:00:27.743" end="00:00:27.879">栄</span><span begin="00:00:27.879" end="00:00:28.030">も</span><span begin="00:00:28.030" end="00:00:28.113"> </span><span begin="00:00:28.113" end="00:00:28.798">弱</span><span begin="00:00:28.798" end="00:00:29.190">み</span><span begin="00:00:29.190" end="00:00:29.366">さ</span><span begin="00:00:29.366" end="00:00:29.710">え</span><span begin="00:00:29.710" end="00:00:29.880">も</span><span begin="00:00:29.880" end="00:00:30.152">な</span><span begin="00:00:30.152" end="00:00:31.300">い</span><span ttm:role="x-translation">没有虚荣 亦无弱点</span></p>
      <p begin="00:00:31.301" end="00:00:34.159"><span begin="00:00:31.301" end="00:00:31.465">ま</span><span begin="00:00:31.465" end="00:00:31.590">さ</span><span begin="00:00:31.590" end="00:00:31.797">に</span><span begin="00:00:31.797" end="00:00:32.149">上</span><span begin="00:00:32.149" end="00:00:32.405">出</span><span begin="00:00:32.405" end="00:00:32.782">来</span><span begin="00:00:32.782" end="00:00:34.159">だ</span><span ttm:role="x-translation">恰如其分 诱人沉迷</span></p>
      <p begin="00:00:34.160" end="00:00:39.598"><span begin="00:00:34.160" end="00:00:34.259">ま</span><span begin="00:00:34.259" end="00:00:34.357">ぁ</span><span begin="00:00:34.357" end="00:00:34.456"> </span><span begin="00:00:34.456" end="00:00:34.821">そ</span><span begin="00:00:34.821" end="00:00:35.185">う</span><span begin="00:00:35.185" end="00:00:35.345">い</span><span begin="00:00:35.345" end="00:00:35.505">っ</span><span begin="00:00:35.505" end="00:00:36.120">た</span><span begin="00:00:36.120" end="00:00:36.328">ノ</span><span begin="00:00:36.328" end="00:00:36.648">リ</span><span begin="00:00:36.648" end="00:00:37.096">は</span><span begin="00:00:37.096" end="00:00:37.424">出</span><span begin="00:00:37.424" end="00:00:37.745">せ</span><span begin="00:00:37.745" end="00:00:38.056">ず</span><span begin="00:00:38.056" end="00:00:39.598">fin</span><span ttm:role="x-translation">不过 如曾言语 索然无味</span></p>
      <p begin="00:00:39.599" end="00:00:43.226"><span begin="00:00:39.599" end="00:00:39.913">赤</span><span begin="00:00:39.913" end="00:00:40.168">の</span><span begin="00:00:40.168" end="00:00:40.329">ト</span><span begin="00:00:40.329" end="00:00:40.581">ラ</span><span begin="00:00:40.581" end="00:00:40.832">ン</span><span begin="00:00:40.832" end="00:00:41.056">ス</span><span begin="00:00:41.056" end="00:00:41.181">フ</span><span begin="00:00:41.181" end="00:00:41.307">ォ</span><span begin="00:00:41.307" end="00:00:41.432">ー</span><span begin="00:00:41.432" end="00:00:41.616">ム</span><span begin="00:00:41.616" end="00:00:41.708">ス</span><span begin="00:00:41.708" end="00:00:41.800">ー</span><span begin="00:00:41.800" end="00:00:41.952">ツ</span><span begin="00:00:41.952" end="00:00:43.226">は</span><span ttm:role="x-translation">红色的变装西服</span></p>
      <p begin="00:00:43.227" end="00:00:46.239"><span begin="00:00:43.227" end="00:00:43.392">と</span><span begin="00:00:43.392" end="00:00:43.537">て</span><span begin="00:00:43.537" end="00:00:43.864">も</span><span begin="00:00:43.864" end="00:00:44.016">着</span><span begin="00:00:44.016" end="00:00:44.225">こ</span><span begin="00:00:44.225" end="00:00:44.504">な</span><span begin="00:00:44.504" end="00:00:44.688">せ</span><span begin="00:00:44.688" end="00:00:44.856">な</span><span begin="00:00:44.856" end="00:00:46.239">い</span><span ttm:role="x-translation">怎么都穿不惯</span></p>
      <p begin="00:00:46.240" end="00:00:49.863"><span begin="00:00:46.240" end="00:00:46.414">真</span><span begin="00:00:46.414" end="00:00:46.576">夜</span><span begin="00:00:46.576" end="00:00:47.001">中</span><span begin="00:00:47.001" end="00:00:47.165">生</span><span begin="00:00:47.165" end="00:00:47.521">ま</span><span begin="00:00:47.521" end="00:00:47.864">れ</span><span begin="00:00:47.864" end="00:00:49.863">る</span><span ttm:role="x-translation">若能将午夜诞生的感情</span></p>
      <p begin="00:00:49.864" end="00:00:58.312"><span begin="00:00:49.864" end="00:00:50.224">感</span><span begin="00:00:50.224" end="00:00:50.578">情</span><span begin="00:00:50.578" end="00:00:50.814">を</span><span begin="00:00:50.814" end="00:00:51.050">う</span><span begin="00:00:51.050" end="00:00:51.392">ま</span><span begin="00:00:51.392" end="00:00:51.800">く</span><span begin="00:00:51.800" end="00:00:52.744">纏</span><span begin="00:00:52.744" end="00:00:53.144">え</span><span begin="00:00:53.144" end="00:00:53.465">た</span><span begin="00:00:53.465" end="00:00:58.312">ら</span><span ttm:role="x-translation">融合贯穿</span></p>
      <p begin="00:00:58.313" end="00:01:01.916"><span begin="00:00:58.313" end="00:00:58.413">も</span><span begin="00:00:58.413" end="00:00:58.513">う</span><span begin="00:00:58.513" end="00:00:58.645">パ</span><span begin="00:00:58.645" end="00:00:58.776">ッ</span><span begin="00:00:58.776" end="00:00:59.145">と</span><span begin="00:00:59.145" end="00:00:59.300">言</span><span begin="00:00:59.300" end="00:00:59.537">え</span><span begin="00:00:59.537" end="00:00:59.705">る</span><span begin="00:00:59.705" end="00:00:59.859">か</span><span begin="00:00:59.859" end="00:01:01.916">ら</span><span ttm:role="x-translation">因为已能利落言说</span></p>
      <p begin="00:01:01.917" end="00:02:22.760"><span begin="00:01:01.917" end="00:01:02.085">こ</span><span begin="00:01:02.085" end="00:01:02.483">の</span><span begin="00:01:02.483" end="00:01:02.941">気</span><span begin="00:01:02.941" end="00:01:03.582">持</span><span begin="00:01:03.582" end="00:01:03.791">ち</span><span begin="00:01:03.791" end="00:01:04.487">を</span><span begin="00:01:04.487" end="00:01:04.858">ど</span><span begin="00:01:04.858" end="00:01:05.229">う</span><span begin="00:01:05.229" end="00:02:22.760">ぞ</span><span ttm:role="x-translation">就请享用这份感情</span></p>
      <p begin="00:02:22.761" end="00:02:27.456"><span begin="00:02:22.761" end="00:02:23.089">演</span><span begin="00:02:23.089" end="00:02:23.450">じ</span><span begin="00:02:23.450" end="00:02:23.658">て</span><span begin="00:02:23.658" end="00:02:23.929"> </span><span begin="00:02:23.929" end="00:02:24.547">今</span><span begin="00:02:24.547" end="00:02:24.723">夜</span><span begin="00:02:24.723" end="00:02:25.129">も</span><span begin="00:02:25.129" end="00:02:25.465">見</span><span begin="00:02:25.465" end="00:02:26.049">事</span><span begin="00:02:26.049" end="00:02:27.456">さ</span><span ttm:role="x-translation">装模作样的今夜 亦美轮美奂</span></p>
      <p begin="00:02:27.457" end="00:02:32.017"><span begin="00:02:27.457" end="00:02:27.601">見</span><span begin="00:02:27.601" end="00:02:27.924">え</span><span begin="00:02:27.924" end="00:02:28.073">な</span><span begin="00:02:28.073" end="00:02:28.410">く</span><span begin="00:02:28.410" end="00:02:28.740">て</span><span begin="00:02:28.740" end="00:02:29.071">い</span><span begin="00:02:29.071" end="00:02:29.401">い</span><span begin="00:02:29.401" end="00:02:29.774">も</span><span begin="00:02:29.774" end="00:02:31.401">の</span><span begin="00:02:31.401" end="00:02:31.569">ば</span><span begin="00:02:31.569" end="00:02:31.721">か</span><span begin="00:02:31.721" end="00:02:32.017">り</span><span ttm:role="x-translation">揭露的净是些</span></p>
      <p begin="00:02:32.018" end="00:02:34.721"><span begin="00:02:32.018" end="00:02:32.170">披</span><span begin="00:02:32.170" end="00:02:32.521">露</span><span begin="00:02:32.521" end="00:02:32.841">す</span><span begin="00:02:32.841" end="00:02:34.721">る</span><span ttm:role="x-translation">看不见亦无妨的东西</span></p>
      <p begin="00:02:34.722" end="00:02:39.488"><span begin="00:02:34.722" end="00:02:35.049">転</span><span begin="00:02:35.049" end="00:02:35.329">じ</span><span begin="00:02:35.329" end="00:02:35.546">て</span><span begin="00:02:35.546" end="00:02:35.961"> </span><span begin="00:02:35.961" end="00:02:36.585">福</span><span begin="00:02:36.585" end="00:02:36.993">を</span><span begin="00:02:36.993" end="00:02:37.377">期</span><span begin="00:02:37.377" end="00:02:37.858">待</span><span begin="00:02:37.858" end="00:02:38.049">し</span><span begin="00:02:38.049" end="00:02:38.217">た</span><span begin="00:02:38.217" end="00:02:39.488">い</span><span ttm:role="x-translation">转而愿意期待福运</span></p>
      <p begin="00:02:39.489" end="00:02:43.208"><span begin="00:02:39.489" end="00:02:39.649">何</span><span begin="00:02:39.649" end="00:02:39.962">度</span><span begin="00:02:39.962" end="00:02:40.121">目</span><span begin="00:02:40.121" end="00:02:40.753">の</span><span begin="00:02:40.753" end="00:02:41.075">あ</span><span begin="00:02:41.075" end="00:02:41.498">や</span><span begin="00:02:41.498" end="00:02:41.841">か</span><span begin="00:02:41.841" end="00:02:43.208">り</span><span ttm:role="x-translation">继续接受</span></p>
      <p begin="00:02:43.209" end="00:02:46.555"><span begin="00:02:43.209" end="00:02:43.354">受</span><span begin="00:02:43.354" end="00:02:43.660">け</span><span begin="00:02:43.660" end="00:02:43.809">身</span><span begin="00:02:43.809" end="00:02:44.081">が</span><span begin="00:02:44.081" end="00:02:44.545">続</span><span begin="00:02:44.545" end="00:02:44.729">い</span><span begin="00:02:44.729" end="00:02:44.838">て</span><span begin="00:02:44.838" end="00:02:46.555">く</span><span ttm:role="x-translation">第几次的幸运眷顾</span></p>
      <p begin="00:02:46.556" end="00:02:49.900"><span begin="00:02:46.556" end="00:02:46.700">真</span><span begin="00:02:46.700" end="00:02:46.852">夜</span><span begin="00:02:46.852" end="00:02:47.168">中</span><span begin="00:02:47.168" end="00:02:47.340">生</span><span begin="00:02:47.340" end="00:02:47.509">ま</span><span begin="00:02:47.509" end="00:02:47.844">れ</span><span begin="00:02:47.844" end="00:02:49.900">る</span><span ttm:role="x-translation">若被深夜诞生的感情</span></p>
      <p begin="00:02:49.901" end="00:02:58.193"><span begin="00:02:49.901" end="00:02:50.182">感</span><span begin="00:02:50.182" end="00:02:50.535">情</span><span begin="00:02:50.535" end="00:02:50.823">を</span><span begin="00:02:50.823" end="00:02:50.990">う</span><span begin="00:02:50.990" end="00:02:51.584">ま</span><span begin="00:02:51.584" end="00:02:51.862">く</span><span begin="00:02:51.862" end="00:02:52.531">纏</span><span begin="00:02:52.531" end="00:02:53.150">え</span><span begin="00:02:53.150" end="00:02:53.203">た</span><span begin="00:02:53.203" end="00:02:58.193">ら</span><span ttm:role="x-translation">纠缠不休</span></p>
      <p begin="00:02:58.194" end="00:03:01.917"><span begin="00:02:58.194" end="00:02:58.318">も</span><span begin="00:02:58.318" end="00:02:58.442">う</span><span begin="00:02:58.442" end="00:02:58.584">パ</span><span begin="00:02:58.584" end="00:02:58.726">ッ</span><span begin="00:02:58.726" end="00:02:59.042">と</span><span begin="00:02:59.042" end="00:02:59.194">言</span><span begin="00:02:59.194" end="00:02:59.603">え</span><span begin="00:02:59.603" end="00:02:59.746">る</span><span begin="00:02:59.746" end="00:02:59.882">か</span><span begin="00:02:59.882" end="00:03:01.917">ら</span><span ttm:role="x-translation">毕竟已能利落言说</span></p>
      <p begin="00:03:01.918" end="00:03:08.438"><span begin="00:03:01.918" end="00:03:02.101">こ</span><span begin="00:03:02.101" end="00:03:02.477">の</span><span begin="00:03:02.477" end="00:03:02.943">気</span><span begin="00:03:02.943" end="00:03:03.349">持</span><span begin="00:03:03.349" end="00:03:03.567">ち</span><span begin="00:03:03.567" end="00:03:04.093">を</span><span begin="00:03:04.093" end="00:03:04.413">理</span><span begin="00:03:04.413" end="00:03:05.253">解</span><span begin="00:03:05.253" end="00:03:05.426">し</span><span begin="00:03:05.426" end="00:03:08.438">て</span><span ttm:role="x-translation">也请理解 这种心情</span></p>
    </div>
  </body>
</tt>