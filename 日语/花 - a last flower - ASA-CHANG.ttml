<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">花开了</text><text for="L2">花 花开了</text><text for="L3">十分惧怕风吹</text><text for="L4">谁也不曾见过</text><text for="L5">花开了哦</text><text for="L6">花开了</text><text for="L7">花 花开了</text><text for="L8">十分惧怕风吹</text><text for="L9">谁也不曾见过</text><text for="L10">花好像开了</text><text for="L11">花 花开了</text><text for="L12">花 花开了</text><text for="L13">从未见过的</text><text for="L14">花开了哦</text><text for="L15">或许并没有花</text><text for="L16">也不是不可能</text><text for="L17">若是这么想这么做</text><text for="L18">那么那么</text><text for="L19">花就是</text><text for="L20">存在的</text><text for="L21">谁也不曾见过</text><text for="L22">不可能见过</text><text for="L23">不看绽放的花在绽放</text><text for="L24">那里果然</text><text for="L25">那里确实</text><text for="L26">那里确实存在</text><text for="L27">花开了</text><text for="L28">花 花开了</text><text for="L29">十分惧怕风吹</text><text for="L30">谁也不曾见过</text><text for="L31">花开了哦</text><text for="L32">如果是那样是那样</text><text for="L33">十分惧怕风吹</text><text for="L34">谁也不曾见过</text><text for="L35">那是花 是花 是花</text><text for="L36">惧怕着风吹 在风中颤抖</text><text for="L37">花在风中摇摆不定</text><text for="L38">害怕着颤抖着 风呼呼吹过</text><text for="L39">带走了花的传言</text><text for="L40">十分惧怕风吹</text><text for="L41">花朵颤抖着恐惧着</text><text for="L42">在风中摇摆不定</text><text for="L43">恐惧着在风中摇摆不定</text><text for="L44">谁也不曾见过</text><text for="L45">不可能见过的花</text><text for="L46">害怕着风吹</text><text for="L47">颤抖着摇摆不定</text><text for="L48">风把花的传言</text><text for="L49">呼呼地送来过来</text><text for="L50">花在害怕</text><text for="L51">摇摆不定</text><text for="L52">花在颤抖</text><text for="L53">恐惧地摇摆着</text><text for="L54">颤抖着摇摆不定</text><text for="L55">被风吹得摇摇欲坠</text><text for="L56">似乎被摇晃得害怕了</text><text for="L57">花哭了哦</text><text for="L58">花 花哭了哦</text><text for="L59">被强烈的风吹拂</text><text for="L60">从未见过阳光</text><text for="L61">花哭了哦</text><text for="L62">比起刚才</text><text for="L63">风声更响了</text><text for="L64">声音的风比起风声</text><text for="L65">若能掀起更大的</text><text for="L66">声音的风暴</text><text for="L67">花 花哭了哦</text><text for="L68">没有梦境</text><text for="L69">当然没有风</text><text for="L70">明明连云也未动</text><text for="L71">然而明明是这样</text><text for="L72">花朵 那花朵</text><text for="L73">却选择了黑暗 爱上了黑暗</text><text for="L74">花在黑暗中歌唱</text><text for="L75">那可爱的花明明在哭泣</text><text for="L76">明明在哭泣 明明在哭泣</text><text for="L77">花在黑暗中被惹哭</text><text for="L78">被选择 讴歌 被爱</text><text for="L79">从未见过阳光</text><text for="L80">花被选择被惹哭被爱</text><text for="L81">然而似乎依旧爱着黑暗</text><text for="L82">花啊 花的不屈之心里</text><text for="L83">愿光明会为我微笑</text><text for="L84">不屈之心的花</text><text for="L85">在风中摇摆不定</text><text for="L86">为了让它</text><text for="L87">最后不要哭泣</text><text for="L88">磨尖了剪刀</text><text for="L89">为了不被那家伙斩去</text><text for="L90">为了不用被迫摇摆</text><text for="L91">为了不再哭泣</text><text for="L92">为了不会被切断</text><text for="L93">花啊</text><text for="L94">看着月亮吧</text><text for="L95">不能看星星</text><text for="L96">黑暗中 月亮才是真正的光</text><text for="L97">不</text><text for="L98">星星依然美丽</text><text for="L99">如月光一般的东西</text><text for="L100">真正的如星光一般的黑暗啊</text><text for="L101">不行</text><text for="L102">是黑暗</text><text for="L103">月亮才是真正的光</text><text for="L104">真正的光</text><text for="L105">真正的光</text><text for="L106">那么既然如此</text><text for="L107">就让黑暗的波涛来回拍岸吧</text><text for="L108">黑暗是月亮的翻阅者</text><text for="L109">予花以光明</text><text for="L110">予花以光明</text><text for="L111">予花以光明</text><text for="L112">以此为心愿</text><text for="L113">如此一来如此一来如此一来</text><text for="L114">花给出了答案</text><text for="L115">只给出了一次答案</text><text for="L116">只给出了四次答案</text><text for="L117">我不需要光</text><text for="L118">请给我水</text></translation></translations></iTunesMetadata><amll:meta key="musicName" value="花 -a last flower-"/><amll:meta key="musicName" value="Hana - a last flower"/><amll:meta key="artists" value="ASA-CHANG"/><amll:meta key="artists" value="巡礼"/><amll:meta key="artists" value="JUNRAY"/><amll:meta key="album" value="惡の花譜"/><amll:meta key="album" value="Aku no Kafu - EP"/><amll:meta key="qqMusicId" value="002Gygig4C19sP"/><amll:meta key="appleMusicId" value="1664357938"/><amll:meta key="isrc" value="JPKI01313196"/></metadata></head><body><div begin="0:34.810" end="6:11.475"><p begin="0:34.810" end="0:37.665" itunes:key="L1" ttm:agent="v1"><span begin="0:34.810" end="0:35.458">花</span><span begin="0:35.458" end="0:36.110">が</span><span begin="0:36.110" end="0:36.315">咲</span><span begin="0:36.315" end="0:36.705">い</span><span begin="0:36.705" end="0:37.233">た</span><span begin="0:37.233" end="0:37.665">よ</span></p><p begin="0:38.481" end="0:42.561" itunes:key="L2" ttm:agent="v1"><span begin="0:38.481" end="0:40.392">花</span><span begin="0:40.392" end="0:40.745">が</span>  <span begin="0:40.745" end="0:41.315">花</span><span begin="0:41.315" end="0:41.673">が</span><span begin="0:41.673" end="0:41.897">咲</span><span begin="0:41.897" end="0:42.050">い</span><span begin="0:42.050" end="0:42.207">た</span><span begin="0:42.207" end="0:42.561">よ</span></p><p begin="0:43.273" end="0:46.149" itunes:key="L3" ttm:agent="v1"><span begin="0:43.273" end="0:43.761">酷</span><span begin="0:43.761" end="0:44.104">く</span><span begin="0:44.104" end="0:44.473">風</span><span begin="0:44.473" end="0:44.739">に</span><span begin="0:44.739" end="0:45.089">怯</span><span begin="0:45.089" end="0:46.024">え</span><span begin="0:46.024" end="0:46.149">た</span></p><p begin="0:46.590" end="0:51.162" itunes:key="L4" ttm:agent="v1"><span begin="0:46.590" end="0:47.365">誰</span><span begin="0:47.365" end="0:48.777">も</span><span begin="0:48.777" end="0:49.610">見</span><span begin="0:49.610" end="0:50.074">た</span><span begin="0:50.074" end="0:50.299">こ</span><span begin