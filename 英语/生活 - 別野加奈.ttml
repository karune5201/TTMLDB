  <body>
    <div>
      <p begin="00:00:32.200" end="00:00:37.830" itunes:key="L1"><span begin="00:00:32.200" end="00:00:32.480">写</span><span begin="00:00:32.480" end="00:00:33.240">真</span><span begin="00:00:33.240" end="00:00:33.470">の</span><span begin="00:00:33.470" end="00:00:34.170">中</span><span begin="00:00:34.170" end="00:00:34.840">で</span><span begin="00:00:34.840" end="00:00:35.530">私</span><span begin="00:00:35.530" end="00:00:35.980">が</span><span begin="00:00:35.980" end="00:00:36.240">泣</span><span begin="00:00:36.240" end="00:00:36.870">い</span><span begin="00:00:36.870" end="00:00:37.100">て</span><span begin="00:00:37.100" end="00:00:37.830">る</span><span ttm:role="x-translation">照片中的我在哭泣</span></p>
      <p begin="00:00:38.120" end="00:00:45.670" itunes:key="L2"><span begin="00:00:38.120" end="00:00:38.290">フ</span><span begin="00:00:38.290" end="00:00:38.510">ィ</span><span begin="00:00:38.510" end="00:00:38.710">ル</span><span begin="00:00:38.710" end="00:00:39.170">ム</span><span begin="00:00:39.170" end="00:00:40.090">に</span><span begin="00:00:40.090" end="00:00:40.930">映</span><span begin="00:00:40.930" end="00:00:41.450">ら</span><span begin="00:00:41.450" end="00:00:41.740">な</span><span begin="00:00:41.740" end="00:00:42.290">い</span><span begin="00:00:42.290" end="00:00:43.080">涙</span><span begin="00:00:43.080" end="00:00:43.720">の</span><span begin="00:00:43.720" end="00:00:44.540">風</span><span begin="00:00:44.540" end="00:00:45.670">景</span><span ttm:role="x-translation">这是胶片没拍摄到的眼泪的风景</span></p>
      <p begin="00:00:46.820" end="00:00:52.430" itunes:key="L3"><span begin="00:00:46.820" end="00:00:47.070">や</span><span begin="00:00:47.070" end="00:00:47.260">が</span><span begin="00:00:47.260" end="00:00:47.850">て</span><span begin="00:00:47.850" end="00:00:48.430">色</span><span begin="00:00:48.430" end="00:00:48.590">褪</span><span begin="00:00:48.590" end="00:00:49.320">せ</span><span begin="00:00:49.320" end="00:00:49.830">忘</span><span begin="00:00:49.830" end="00:00:50.020">れ</span><span begin="00:00:50.020" end="00:00:50.380">て</span><span begin="00:00:50.380" end="00:00:50.740">し</span><span begin="00:00:50.740" end="00:00:51.250">ま</span><span begin="00:00:51.250" end="00:00:51.380">う</span><span begin="00:00:51.380" end="00:00:51.620">け</span><span begin="00:00:51.620" end="00:00:52.430">ど</span><span ttm:role="x-translation">但我在这里到底呼吸了几万次呢</span></p>
      <p begin="00:00:52.650" end="00:01:00.280" itunes:key="L4"><span begin="00:00:52.650" end="00:00:52.990">こ</span><span begin="00:00:52.990" end="00:00:53.750">こ</span><span begin="00:00:53.750" end="00:00:54.560">で</span><span begin="00:00:54.560" end="00:00:55.170">何</span><span begin="00:00:55.170" end="00:00:56.220">万</span><span begin="00:00:56.220" end="00:00:56.780">回</span><span begin="00:00:56.780" end="00:00:57.140">息</span><span begin="00:00:57.140" end="00:00:57.270">を</span><span begin="00:00:57.270" end="00:00:57.770">し</span><span begin="00:00:57.770" end="00:00:57.860">て</span><span begin="00:00:57.860" end="00:00:58.040">る</span><span begin="00:00:58.040" end="00:00:58.730">の</span><span begin="00:00:58.730" end="00:00:58.900">だ</span><span begin="00:00:58.900" end="00:00:59.080">ろ</span><span begin="00:00:59.080" end="00:01:00.280">う</span><span ttm:role="x-translation">照片中的我在哭泣</span></p>
      <p begin="00:01:01.340" end="00:01:06.930" itunes:key="L5"><span begin="00:01:01.340" end="00:01:01.560">写</span><span begin="00:01:01.560" end="00:01:02.320">真</span><span begin="00:01:02.320" end="00:01:02.550">の</span><span begin="00:01:02.550" end="00:01:03.240">中</span><span begin="00:01:03.240" end="00:01:03.930">で</span><span begin="00:01:03.930" end="00:01:04.610">私</span><span begin="00:01:04.610" end="00:01:05.060">が</span><span begin="00:01:05.060" end="00:01:05.350">泣</span><span begin="00:01:05.350" end="00:01:05.980">い</span><span begin="00:01:05.980" end="00:01:06.200">て</span><span begin="00:01:06.200" end="00:01:06.930">る</span><span ttm:role="x-translation">这是胶片没拍摄到的</span></p>
      <p begin="00:01:07.240" end="00:01:11.160" itunes:key="L6"><span begin="00:01:07.240" end="00:01:07.370">フ</span><span begin="00:01:07.370" end="00:01:07.580">ィ</span><span begin="00:01:07.580" end="00:01:07.980">ル</span><span begin="00:01:07.980" end="00:01:08.270">ム</span><span begin="00:01:08.270" end="00:01:09.340">に</span><span begin="00:01:09.340" end="00:01:10.060">映</span><span begin="00:01:10.060" end="00:01:10.550">ら</span><span begin="00:01:10.550" end="00:01:10.820">な</span><span begin="00:01:10.820" end="00:01:11.160">い</span><span ttm:role="x-translation">朝霞的味道</span></p>
      <p begin="00:01:11.360" end="00:01:14.760" itunes:key="L7"><span begin="00:01:11.360" end="00:01:11.810">朝</span><span begin="00:01:11.810" end="00:01:12.310">焼</span><span begin="00:01:12.310" end="00:01:12.590">け</span><span begin="00:01:12.590" end="00:01:13.140">の</span><span begin="00:01:13.140" end="00:01:14.160">匂</span><span begin="00:01:14.160" end="00:01:14.760">い</span><span ttm:role="x-translation">我纤弱的身体</span></p>
      <p begin="00:01:15.900" end="00:01:21.560" itunes:key="L8"><span begin="00:01:15.900" end="00:01:16.360">毛</span><span begin="00:01:16.360" end="00:01:16.610">布</span><span begin="00:01:16.610" end="00:01:17.290">に</span><span begin="00:01:17.290" end="00:01:17.420">包</span><span begin="00:01:17.420" end="00:01:18.030">ま</span><span begin="00:01:18.030" end="00:01:18.670">り</span><span begin="00:01:18.670" end="00:01:19.120">怯</span><span begin="00:01:19.120" end="00:01:19.600">え</span><span begin="00:01:19.600" end="00:01:19.830">て</span><span begin="00:01:19.830" end="00:01:20.470">い</span><span begin="00:01:20.470" end="00:01:20.610">て</span><span begin="00:01:20.610" end="00:01:21.560">も</span><span ttm:role="x-translation">在毛毯中发抖着</span></p>
      <p begin="00:01:21.760" end="00:01:25.580" itunes:key="L9"><span begin="00:01:21.760" end="00:01:22.110">か</span><span begin="00:01:22.110" end="00:01:22.850">弱</span><span begin="00:01:22.850" end="00:01:23.540">い</span><span begin="00:01:23.540" end="00:01:24.560">正</span><span begin="00:01:24.560" end="00:01:25.130">像</span><span begin="00:01:25.130" end="00:01:25.580">は</span><span ttm:role="x-translation">谁都已经救不了我了吧</span></p>
      <p begin="00:01:25.830" end="00:01:29.790" itunes:key="L10"><span begin="00:01:25.830" end="00:01:26.400">救</span><span begin="00:01:26.400" end="00:01:26.860">わ</span><span begin="00:01:26.860" end="00:01:27.110">れ</span><span begin="00:01:27.110" end="00:01:27.430">や</span><span begin="00:01:27.430" end="00:01:28.030">し</span><span begin="00:01:28.030" end="00:01:28.520">な</span><span begin="00:01:28.520" end="00:01:28.680">い</span><span begin="00:01:28.680" end="00:01:29.180">の</span><span begin="00:01:29.180" end="00:01:29.600">で</span><span begin="00:01:29.600" end="00:01:29.790">す</span><span ttm:role="x-translation">我与照片中的我说道</span></p>
      <p begin="00:01:29.890" end="00:01:35.650" itunes:key="L11"><span begin="00:01:29.890" end="00:01:30.210">写</span><span begin="00:01:30.210" end="00:01:30.760">真</span><span begin="00:01:30.760" end="00:01:30.980">の</span><span begin="00:01:30.980" end="00:01:31.420">中</span><span begin="00:01:31.420" end="00:01:31.680">の</span><span begin="00:01:31.680" end="00:01:32.820">私</span><span begin="00:01:32.820" end="00:01:33.490">が</span><span begin="00:01:33.490" end="00:01:33.520">言</span><span begin="00:01:33.520" end="00:01:34.360">う</span><span begin="00:01:34.360" end="00:01:34.570">に</span><span begin="00:01:34.570" end="00:01:35.650">は</span><span ttm:role="x-translation">就算你不能完美的演出自己也没关系</span></p>
      <p begin="00:01:36.140" end="00:01:43.840" itunes:key="L12"><span begin="00:01:36.140" end="00:01:36.710">例</span><span begin="00:01:36.710" end="00:01:37.140">え</span><span begin="00:01:37.140" end="00:01:37.650">今</span><span begin="00:01:37.650" end="00:01:37.970">は</span><span begin="00:01:37.970" end="00:01:38.290">自</span><span begin="00:01:38.290" end="00:01:38.760">分</span><span begin="00:01:38.760" end="00:01:39.890">を</span><span begin="00:01:39.890" end="00:01:40.380">演</span><span begin="00:01:40.380" end="00:01:40.700">じ</span><span begin="00:01:40.700" end="00:01:40.950">切</span><span begin="00:01:40.950" end="00:01:41.410">れ</span><span begin="00:01:41.410" end="00:01:41.840">な</span><span begin="00:01:41.840" end="00:01:42.320">く</span><span begin="00:01:42.320" end="00:01:42.730">て</span><span begin="00:01:42.730" end="00:01:43.840">も</span><span ttm:role="x-translation">我与照片中的我说道</span></p>
      <p begin="00:01:44.440" end="00:01:50.110" itunes:key="L13"><span begin="00:01:44.440" end="00:01:44.770">写</span><span begin="00:01:44.770" end="00:01:45.280">真</span><span begin="00:01:45.280" end="00:01:45.500">の</span><span begin="00:01:45.500" end="00:01:45.940">中</span><span begin="00:01:45.940" end="00:01:46.190">の</span><span begin="00:01:46.190" end="00:01:47.340">私</span><span begin="00:01:47.340" end="00:01:48.030">が</span><span begin="00:01:48.030" end="00:01:48.130">言</span><span begin="00:01:48.130" end="00:01:48.900">う</span><span begin="00:01:48.900" end="00:01:49.080">に</span><span begin="00:01:49.080" end="00:01:50.110">は</span><span ttm:role="x-translation">不知从何时起</span></p>
      <p begin="00:01:50.720" end="00:01:54.070" itunes:key="L14"><span begin="00:01:50.720" end="00:01:50.940">い</span><span begin="00:01:50.940" end="00:01:51.210">つ</span><span begin="00:01:51.210" end="00:01:51.510">か</span><span begin="00:01:51.510" end="00:01:51.890">知</span><span begin="00:01:51.890" end="00:01:52.180">ら</span><span begin="00:01:52.180" end="00:01:52.450">な</span><span begin="00:01:52.450" end="00:01:52.650">い</span><span begin="00:01:52.650" end="00:01:53.690">間</span><span begin="00:01:53.690" end="00:01:54.070">に</span><span ttm:role="x-translation">我大概已经学会了这种演技了吧</span></p>
      <p begin="00:01:54.320" end="00:02:01.900" itunes:key="L15"><span begin="00:01:54.320" end="00:01:54.550">身</span><span begin="00:01:54.550" end="00:01:55.090">に</span><span begin="00:01:55.090" end="00:01:55.450">つ</span><span begin="00:01:55.450" end="00:01:55.940">い</span><span begin="00:01:55.940" end="00:01:56.060">て</span><span begin="00:01:56.060" end="00:01:56.460">し</span><span begin="00:01:56.460" end="00:01:57.080">ま</span><span begin="00:01:57.080" end="00:01:58.090">う</span><span begin="00:01:58.090" end="00:01:58.440">は</span><span begin="00:01:58.440" end="00:01:58.760">ず</span><span begin="00:01:58.760" end="00:02:01.210">で</span><span begin="00:02:01.210" end="00:02:01.900">す</span><span ttm:role="x-translation">照片中的我在哭泣</span></p>
      <p begin="00:02:28.610" end="00:02:34.230" itunes:key="L16"><span begin="00:02:28.610" end="00:02:28.870">写</span><span begin="00:02:28.870" end="00:02:29.590">真</span><span begin="00:02:29.590" end="00:02:29.830">の</span><span begin="00:02:29.830" end="00:02:30.540">中</span><span begin="00:02:30.540" end="00:02:31.170">で</span><span begin="00:02:31.170" end="00:02:31.900">私</span><span begin="00:02:31.900" end="00:02:32.360">が</span><span begin="00:02:32.360" end="00:02:32.660">泣</span><span begin="00:02:32.660" end="00:02:33.230">い</span><span begin="00:02:33.230" end="00:02:33.480">て</span><span begin="00:02:33.480" end="00:02:34.230">る</span><span ttm:role="x-translation">这是胶片无法拍摄到的眼泪的风景</span></p>
      <p begin="00:02:34.480" end="00:02:42.080" itunes:key="L17"><span begin="00:02:34.480" end="00:02:34.670">フ</span><span begin="00:02:34.670" end="00:02:34.870">ィ</span><span begin="00:02:34.870" end="00:02:35.190">ル</span><span begin="00:02:35.190" end="00:02:35.540">ム</span><span begin="00:02:35.540" end="00:02:36.400">に</span><span begin="00:02:36.400" end="00:02:37.310">映</span><span begin="00:02:37.310" end="00:02:37.830">ら</span><span begin="00:02:37.830" end="00:02:38.090">な</span><span begin="00:02:38.090" end="00:02:38.670">い</span><span begin="00:02:38.670" end="00:02:39.440">涙</span><span begin="00:02:39.440" end="00:02:40.040">の</span><span begin="00:02:40.040" end="00:02:40.930">風</span><span begin="00:02:40.930" end="00:02:42.080">景</span><span ttm:role="x-translation">虽然胶片渐渐褪色</span></p>
      <p begin="00:02:43.160" end="00:02:48.820" itunes:key="L18"><span begin="00:02:43.160" end="00:02:43.410">や</span><span begin="00:02:43.410" end="00:02:43.610">が</span><span begin="00:02:43.610" end="00:02:44.240">て</span><span begin="00:02:44.240" end="00:02:44.760">色</span><span begin="00:02:44.760" end="00:02:44.960">褪</span><span begin="00:02:44.960" end="00:02:45.730">せ</span><span begin="00:02:45.730" end="00:02:46.190">忘</span><span begin="00:02:46.190" end="00:02:46.380">れ</span><span begin="00:02:46.380" end="00:02:46.750">て</span><span begin="00:02:46.750" end="00:02:47.110">し</span><span begin="00:02:47.110" end="00:02:47.670">ま</span><span begin="00:02:47.670" end="00:02:47.750">う</span><span begin="00:02:47.750" end="00:02:47.970">け</span><span begin="00:02:47.970" end="00:02:48.820">ど</span><span ttm:role="x-translation">但我究竟在这里度过了几千个夜晚呢</span></p>
      <p begin="00:02:49.070" end="00:02:56.650" itunes:key="L19"><span begin="00:02:49.070" end="00:02:49.320">こ</span><span begin="00:02:49.320" end="00:02:50.100">こ</span><span begin="00:02:50.100" end="00:02:50.880">で</span><span begin="00:02:50.880" end="00:02:51.890">何</span><span begin="00:02:51.890" end="00:02:52.530">千</span><span begin="00:02:52.530" end="00:02:53.060">回</span><span begin="00:02:53.060" end="00:02:53.490">夜</span><span begin="00:02:53.490" end="00:02:53.680">を</span><span begin="00:02:53.680" end="00:02:54.140">超</span><span begin="00:02:54.140" end="00:02:54.610">え</span><span begin="00:02:54.610" end="00:02:54.810">た</span><span begin="00:02:54.810" end="00:02:55.100">ん</span><span begin="00:02:55.100" end="00:02:55.240">だ</span><span begin="00:02:55.240" end="00:02:55.480">ろ</span><span begin="00:02:55.480" end="00:02:56.650">う</span><span ttm:role="x-translation">照片中的我在哭泣</span></p>
      <p begin="00:02:57.700" end="00:03:03.290" itunes:key="L20"><span begin="00:02:57.700" end="00:02:57.940">写</span><span begin="00:02:57.940" end="00:02:58.670">真</span><span begin="00:02:58.670" end="00:02:58.910">の</span><span begin="00:02:58.910" end="00:02:59.610">中</span><span begin="00:02:59.610" end="00:03:00.250">で</span><span begin="00:03:00.250" end="00:03:00.970">私</span><span begin="00:03:00.970" end="00:03:01.420">が</span><span begin="00:03:01.420" end="00:03:01.690">泣</span><span begin="00:03:01.690" end="00:03:02.320">い</span><span begin="00:03:02.320" end="00:03:02.550">て</span><span begin="00:03:02.550" end="00:03:03.290">る</span><span ttm:role="x-translation">这是胶片无法拍摄到的</span></p>
      <p begin="00:03:03.590" end="00:03:07.410" itunes:key="L21"><span begin="00:03:03.590" end="00:03:03.730">フ</span><span begin="00:03:03.730" end="00:03:03.950">ィ</span><span begin="00:03:03.950" end="00:03:04.310">ル</span><span begin="00:03:04.310" end="00:03:04.630">ム</span><span begin="00:03:04.630" end="00:03:05.710">に</span><span begin="00:03:05.710" end="00:03:06.400">映</span><span begin="00:03:06.400" end="00:03:06.880">ら</span><span begin="00:03:06.880" end="00:03:07.180">な</span><span begin="00:03:07.180" end="00:03:07.410">い</span><span ttm:role="x-translation">入睡的鼾声</span></p>
      <p begin="00:03:07.530" end="00:03:10.760" itunes:key="L22"><span begin="00:03:07.530" end="00:03:07.860">寝</span><span begin="00:03:07.860" end="00:03:07.980">起</span><span begin="00:03:07.980" end="00:03:08.240">き</span><span begin="00:03:08.240" end="00:03:10.170">の</span><span begin="00:03:10.170" end="00:03:10.230">鼻</span><span begin="00:03:10.230" end="00:03:10.760">声</span><span ttm:role="x-translation">最近才学会了</span></p>
