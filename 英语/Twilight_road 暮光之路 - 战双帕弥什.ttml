            <p begin="01:16.450" end="01:19.921" ttm:agent="v1" itunes:key="L16">
                <span begin="01:16.450" end="01:16.665">Open </span>
                <span begin="01:16.665" end="01:17.001">with </span>
                <span begin="01:17.001" end="01:17.657">raven </span>
                <span begin="01:17.657" end="01:17.993">wings </span>
                <span begin="01:17.993" end="01:18.329">I </span>
                <span begin="01:18.329" end="01:19.921">soar</span>
                <span ttm:role="x-translation" xml:lang="zh-CN">张开灰鸦羽翼 我向前翱翔</span>
            </p>
            <p begin="01:19.921" end="01:22.043" ttm:agent="v1" itunes:key="L17">
                <span begin="01:19.921" end="01:20.193">In </span>
                <span begin="01:20.193" end="01:20.752">the </span>
                <span begin="01:20.752" end="01:21.376">endless </span>
                <span begin="01:21.376" end="01:22.043">dark</span>
                <span ttm:role="x-translation" xml:lang="zh-CN">即使前方黑暗无边</span>
            </p>
            <p begin="01:22.043" end="01:25.546" ttm:agent="v1" itunes:key="L18">
                <span begin="01:22.043" end="01:22.371">Go </span>
                <span begin="01:22.371" end="01:22.739">ahead </span>
                <span begin="01:22.739" end="01:23.099">with </span>
                <span begin="01:23.099" end="01:23.531">no </span>
                <span begin="01:23.531" end="01:25.546">fear</span>
