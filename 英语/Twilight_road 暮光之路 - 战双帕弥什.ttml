    <body dur="04:12.694">
        <div begin="00:11.841" end="04:12.694">
            <p begin="00:11.841" end="00:16.160" ttm:agent="v1" itunes:key="L1">
                <span begin="00:11.841" end="00:12.841">When </span>
                <span begin="00:12.841" end="00:13.976">time </span>
                <span begin="00:13.976" end="00:14.243">comes </span>
                <span begin="00:14.243" end="00:14.560">to </span>
                <span begin="00:14.560" end="00:14.904">an </span>
                <span begin="00:14.904" end="00:16.160">end</span>
                <span ttm:role="x-translation" xml:lang="zh-CN">当最后时刻临近</span>
            </p>
            <p begin="00:16.160" end="00:21.296" ttm:agent="v1" itunes:key="L2">
                <span begin="00:16.160" end="00:16.832">Shadows </span>
                <span begin="00:16.832" end="00:17.168">spread </span>
                <span begin="00:17.168" end="00:17.561">in </span>
                <span begin="00:17.561" end="00:18.360">silence </span>
                <span begin="00:18.360" end="00:19.168">deepen </span>
                <span begin="00:19.168" end="00:21.296">around</span>
                <span ttm:role="x-translation" xml:lang="zh-CN">阴影笼罩蔓延在我们周围</span>
            </p>
            <p begin="00:22.032" end="00:31.408" ttm:agent="v1" itunes:key="L3">
                <span begin="00:22.032" end="00:22.921">I </span>
                <span begin="00:22.921" end="00:23.984">embrace </span>
                <span begin="00:23.984" end="00:25.208">you </span>
                <span begin="00:25.208" end="00:25.577">try </span>
                <span begin="00:25.577" end="00:25.896">to </span>
                <span begin="00:25.896" end="00:26.656">feeling </span>
                <span begin="00:26.656" end="00:27.144">each </span>
                <span begin="00:27.144" end="00:27.464">beat </span>
                <span begin="00:27.464" end="00:28.568">of </span>
                <span begin="00:28.568" end="00:29.680">your </span>
                <span begin="00:29.680" end="00:31.408">heart</span>
                <span ttm:role="x-translation" xml:lang="zh-CN">我拥抱你，试图感受你的每一刻心跳</span>
            </p>
            <p begin="00:31.697" end="00:40.030" ttm:agent="v1" itunes:key="L4">
                <span begin="00:31.697" end="00:31.945">With </span>
                <span begin="00:31.945" end="00:34.145">every </span>
                <span begin="00:34.145" end="00:36.089">step </span>
                <span begin="00:36.089" end="00:38.353">towards </span>
                <span begin="00:38.353" end="00:38.650">the </span>
                <span begin="00:38.650" end="00:40.030">dark</span>
                <span ttm:role="x-translation" xml:lang="zh-CN">随着我一步步走向黑暗</span>
            </p>
            <p begin="00:40.030" end="00:43.261" ttm:agent="v1" itunes:key="L5">
                <span begin="00:40.030" end="00:41.030">My </span>
                <span begin="00:41.030" end="00:41.311">heart </span>
                <span begin="00:41.311" end="00:41.988">far </span>
                <span begin="00:41.988" end="00:43.261">away</span>
                <span ttm:role="x-translation" xml:lang="zh-CN">我的心，渐渐远去</span>
            </p>
            <p begin="00:43.261" end="00:49.606" ttm:agent="v1" itunes:key="L6">
                <span begin="00:43.261" end="00:43.501">If </span>
                <span begin="00:43.501" end="00:44.332">only </span>
                <span begin="00:44.332" end="00:44.710">time </span>
                <span begin="00:44.710" end="00:45.285">could </span>
                <span begin="00:45.285" end="00:49.606">stay</span>
                <span ttm:role="x-translation" xml:lang="zh-CN">若时间能停驻此刻</span>
            </p>
            <p begin="00:51.611" end="00:53.902" ttm:agent="v1" itunes:key="L7">
                <span begin="00:51.611" end="00:51.909">With </span>
                <span begin="00:51.909" end="00:52.171">you </span>
                <span begin="00:52.171" end="00:52.512">by </span>
                <span begin="00:52.512" end="00:52.775">my </span>
                <span begin="00:52.775" end="00:53.902">side</span>
                <span ttm:role="x-translation" xml:lang="zh-CN">只要有你在身边</span>
            </p>
            <p begin="00:53.902" end="00:55.887" ttm:agent="v1" itunes:key="L8">
                <span begin="00:53.902" end="00:54.167">Through </span>
                <span begin="00:54.167" end="00:54.400">the </span>
                <span begin="00:54.400" end="00:55.011">shadows </span>
                <span begin="00:55.011" end="00:55.382">and </span>
                <span begin="00:55.382" end="00:55.887">binds</span>
                <span ttm:role="x-translation" xml:lang="zh-CN">穿越阴影和荆棘</span>
            </p>
            <p begin="00:55.887" end="00:58.447" ttm:agent="v1" itunes:key="L9">
                <span begin="00:55.887" end="00:56.241">I </span>
                <span begin="00:56.241" end="00:56.663">am </span>
                <span begin="00:56.663" end="00:57.150">strong </span>
                <span begin="00:57.150" end="00:57.366">to </span>
                <span begin="00:57.366" end="00:58.447">face</span>
                <span ttm:role="x-translation" xml:lang="zh-CN">我愿鼓起勇气面对</span>
            </p>
            <p begin="00:58.447" end="01:01.938" ttm:agent="v1" itunes:key="L10">
                <span begin="00:58.447" end="00:58.770">Enternal </span>
                <span begin="00:58.770" end="00:59.250">night </span>
                <span begin="00:59.250" end="01:00.011">unknown </span>
                <span begin="01:00.011" end="01:01.938">fate</span>
                <span ttm:role="x-translation" xml:lang="zh-CN">永夜之中，未知命运</span>
            </p>
            <p begin="01:01.938" end="01:04.314" ttm:agent="v1" itunes:key="L11">
