                <span begin="01:58.145" end="01:59.233">as </span>
                <span begin="01:59.233" end="02:01.585">shadows </span>
                <span begin="02:01.585" end="02:02.889">stretch </span>
                <span begin="02:02.889" end="02:03.810">little </span>
