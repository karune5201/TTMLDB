<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/itunes/ttml">
    <body>
        <div>
            <p begin="00:00:02.688" end="00:00:05.680">
                <span begin="00:00:02.688" end="00:00:02.912">Sometimes </span>
                <span begin="00:00:02.912" end="00:00:03.113">we </span>
                <span begin="00:00:03.113" end="00:00:04.616">forget </span>
                <span begin="00:00:04.616" end="00:00:04.736">&apos;cause </span>
                <span begin="00:00:04.736" end="00:00:04.848">we </span>
                <span begin="00:00:04.848" end="00:00:04.992">get </span>
                <span begin="00:00:04.992" end="00:00:05.183">caught </span>
                <span begin="00:00:05.183" end="00:00:05.360">up </span>
                <span begin="00:00:05.360" end="00:00:05.488">in </span>
                <span begin="00:00:05.488" end="00:00:05.680">life</span>
                <span ttm:role="x-translation">有时我们会迷茫 因为那灯红酒绿的生活</span>
            </p>
            <p begin="00:00:06.744" end="00:00:08.201">
                <span begin="00:00:06.744" end="00:00:06.880">And </span>
                <span begin="00:00:06.880" end="00:00:07.010">don&apos;t </span>
                <span begin="00:00:07.010" end="00:00:07.145">see </span>
                <span begin="00:00:07.145" end="00:00:07.289">the </span>
                <span begin="00:00:07.289" end="00:00:07.457">things </span>
                <span begin="00:00:07.457" end="00:00:07.656">that </span>
                <span begin="00:00:07.656" end="00:00:07.857">we </span>
                <span begin="00:00:07.857" end="00:00:07.985">should </span>
                <span begin="00:00:07.985" end="00:00:08.201">see</span>
                <span ttm:role="x-translation">我们看不见应见之物</span>
            </p>
            <p begin="00:00:08.985" end="00:00:10.377">
                <span begin="00:00:08.985" end="00:00:09.113">And </span>
                <span begin="00:00:09.113" end="00:00:09.241">appreciate </span>
                <span begin="00:00:09.241" end="00:00:09.409">the </span>
                <span begin="00:00:09.409" end="00:00:09.577">things </span>
                <span begin="00:00:09.577" end="00:00:09.745">that </span>
                <span begin="00:00:09.745" end="00:00:09.936">we </span>
                <span begin="00:00:09.936" end="00:00:10.129">should </span>
                <span begin="00:00:10.129" end="00:00:10.377">appreciate</span>
                <span ttm:role="x-translation">也没有注重那些我们应重视的东西</span>
            </p>
            <p begin="00:00:12.185" end="00:00:13.153">
                <span begin="00:00:12.185" end="00:00:12.313">This </span>
                <span begin="00:00:12.313" end="00:00:12.434">song </span>
                <span begin="00:00:12.434" end="00:00:12.593">is </span>
                <span begin="00:00:12.593" end="00:00:12.809">for </span>
                <span begin="00:00:12.809" end="00:00:12.978">the </span>
                <span begin="00:00:12.978" end="00:00:13.153">people</span>
                <span ttm:role="x-translation">这首歌是献给各位的</span>
            </p>
            <p begin="00:00:14.743" end="00:00:17.104">
                <span begin="00:00:14.743" end="00:00:14.855">And </span>
                <span begin="00:00:14.855" end="00:00:14.976">the </span>
                <span begin="00:00:14.976" end="00:00:15.271">beautiful </span>
                <span begin="00:00:15.271" end="00:00:15.569">things </span>
                <span begin="00:00:15.569" end="00:00:15.751">in </span>
                <span begin="00:00:15.751" end="00:00:15.951">this </span>
                <span begin="00:00:15.951" end="00:00:16.159">world </span>
                <span begin="00:00:16.159" end="00:00:16.345">that </span>
                <span begin="00:00:16.345" end="00:00:16.519">we </span>
                <span begin="00:00:16.519" end="00:00:16.711">take </span>
                <span begin="00:00:16.711" end="00:00:16.888">granted </span>
                <span begin="00:00:16.888" end="00:00:17.104">of</span>
                <span ttm:role="x-translation">也是献给那些我们所见到的美好事物</span>
            </p>
            <p begin="00:00:17.904" end="00:00:18.538">
                <span begin="00:00:17.904" end="00:00:18.050">It&apos;s </span>
                <span begin="00:00:18.050" end="00:00:18.304">called &quot;</span>
                <span begin="00:00:18.304" end="00:00:18.538">Jenny&quot;</span>
                <span ttm:role="x-translation">它叫做Jenny</span>
            </p>
            <p begin="00:00:19.425" end="00:00:19.760">
                <span begin="00:00:19.425" end="00:00:19.568">Listen </span>
                <span begin="00:00:19.568" end="00:00:19.760">up</span>
                <span ttm:role="x-translation">听好了</span>
            </p>
            <p begin="00:00:20.664" end="00:00:20.864">
                <span begin="00:00:20.664" end="00:00:20.864">Yeah</span>
                <span ttm:role="x-translation">//</span>
            </p>
            <p begin="00:00:21.992" end="00:00:23.832">
                <span begin="00:00:21.992" end="00:00:22.104">I </span>
                <span begin="00:00:22.104" end="00:00:22.224">heard </span>
                <span begin="00:00:22.224" end="00:00:22.353">of </span>
                <span begin="00:00:22.353" end="00:00:22.520">the </span>
                <span begin="00:00:22.520" end="00:00:22.704">beat </span>
                <span begin="00:00:22.704" end="00:00:22.872">and </span>
                <span begin="00:00:22.872" end="00:00:23.032">thought </span>
                <span begin="00:00:23.032" end="00:00:23.208">of </span>
                <span begin="00:00:23.208" end="00:00:23.504">something </span>
                <span begin="00:00:23.504" end="00:00:23.832">beautiful</span>
                <span ttm:role="x-translation">我听着鼓点 思考着何为绚丽多彩</span>
            </p>
            <p begin="00:00:24.296" end="00:00:26.537">
                <span begin="00:00:24.296" end="00:00:24.480">Forced </span>
                <span begin="00:00:24.480" end="00:00:24.632">to </span>
                <span begin="00:00:24.632" end="00:00:24.824">be </span>
                <span begin="00:00:24.824" end="00:00:25.009">a </span>
                <span begin="00:00:25.009" end="00:00:25.176">robot </span>
                <span begin="00:00:25.176" end="00:00:25.408">but </span>
                <span begin="00:00:25.408" end="00:00:25.593">seeking </span>
                <span begin="00:00:25.593" end="00:00:25.785">for </span>
                <span begin="00:00:25.785" end="00:00:26.096">the </span>
                <span begin="00:00:26.096" end="00:00:26.537">spiritual</span>
                <span ttm:role="x-translation">被迫做一个呆板的机器人 但内心一直在寻求着精神的慰藉</span>
            </p>
            <p begin="00:00:27.175" end="00:00:29.184">
                <span begin="00:00:27.175" end="00:00:27.330">Living </span>
                <span begin="00:00:27.330" end="00:00:27.544">this </span>
                <span begin="00:00:27.544" end="00:00:27.807">life </span>
                <span begin="00:00:27.807" end="00:00:27.952">and </span>
                <span begin="00:00:27.952" end="00:00:28.167">end </span>
                <span begin="00:00:28.167" end="00:00:28.359">up </span>
                <span begin="00:00:28.359" end="00:00:28.519">at </span>
                <span begin="00:00:28.519" end="00:00:28.751">the </span>
                <span begin="00:00:28.751" end="00:00:29.184">funeral</span>
                <span ttm:role="x-translation">人生之路皆终结于一场葬礼 尽管我渴望成为某某</span>
            </p>
            <p begin="00:00:29.357" end="00:00:31.996">
                <span begin="00:00:29.357" end="00:00:29.486">But </span>
                <span begin="00:00:29.486" end="00:00:30.189">meanwhile &quot;</span>
                <span begin="00:00:30.189" end="00:00:30.339">be </span>
                <span begin="00:00:30.339" end="00:00:30.787">something&quot; </span>
                <span begin="00:00:30.787" end="00:00:30.947">but </span>
                <span begin="00:00:30.947" end="00:00:31.156">nothing </span>
                <span begin="00:00:31.156" end="00:00:31.437">seems </span>
                <span begin="00:00:31.437" end="00:00:31.996">suitable</span>
                <span ttm:role="x-translation">但看起来似乎没有什么是合适的</span>
            </p>
            <p begin="00:00:32.451" end="00:00:34.556">
                <span begin="00:00:32.451" end="00:00:32.596">Life </span>
                <span begin="00:00:32.596" end="00:00:32.787">is </span>
                <span begin="00:00:32.787" end="00:00:32.995">hard </span>
                <span begin="00:00:32.995" end="00:00:33.158">but </span>
                <span begin="00:00:33.158" end="00:00:33.319">you </span>
                <span begin="00:00:33.319" end="00:00:33.485">know </span>
                <span begin="00:00:33.485" end="00:00:33.651">what </span>
                <span begin="00:00:33.651" end="00:00:33.852">to </span>
                <span begin="00:00:33.852" end="00:00:34.141">look </span>
                <span begin="00:00:34.141" end="00:00:34.556">for</span>
                <span ttm:role="x-translation">人生道路是坎坷不平 但你却得明白你到底在追求什么</span>
            </p>
            <p begin="00:00:34.846" end="00:00:37.116">
                <span begin="00:00:34.846" end="00:00:35.020">Love </span>
                <span begin="00:00:35.020" end="00:00:35.188">or </span>
                <span begin="00:00:35.188" end="00:00:35.454">the </span>
                <span begin="00:00:35.454" end="00:00:35.708">friendship </span>
                <span begin="00:00:35.708" end="00:00:35.893">and </span>
                <span begin="00:00:35.893" end="00:00:36.132">maybe </span>
                <span begin="00:00:36.132" end="00:00:36.380">that&apos;s </span>
                <span begin="00:00:36.380" end="00:00:36.667">to </span>
                <span begin="00:00:36.667" end="00:00:36.861">die </span>
                <span begin="00:00:36.861" end="00:00:37.116">for</span>
                <span ttm:role="x-translation">爱情或友谊 或许值得你一辈子都为之拼搏</span>
            </p>
            <p begin="00:00:37.747" end="00:00:39.819">
                <span begin="00:00:37.747" end="00:00:38.019">Only </span>
                <span begin="00:00:38.019" end="00:00:38.348">one </span>
                <span begin="00:00:38.348" end="00:00:38.490">path </span>
                <span begin="00:00:38.490" end="00:00:38.677">and </span>
                <span begin="00:00:38.677" end="00:00:38.866">ain&apos;t </span>
                <span begin="00:00:38.866" end="00:00:39.074">no </span>
                <span begin="00:00:39.074" end="00:00:39.341">really </span>
                <span begin="00:00:39.341" end="00:00:39.546">side </span>
                <span begin="00:00:39.546" end="00:00:39.819">door</span>
                <span ttm:role="x-translation">人生道路漫长 且并无真正意义上的捷径</span>
            </p>
            <p begin="00:00:40.090" end="00:00:42.444">
                <span begin="00:00:40.090" end="00:00:40.275">Writing </span>
                <span begin="00:00:40.275" end="00:00:40.443">for </span>
                <span begin="00:00:40.443" end="00:00:40.659">this </span>
                <span begin="00:00:40.659" end="00:00:40.858">light </span>
                <span begin="00:00:40.858" end="00:00:41.042">and </span>
                <span begin="00:00:41.042" end="00:00:41.259">this </span>
                <span begin="00:00:41.259" end="00:00:41.474">is </span>
                <span begin="00:00:41.474" end="00:00:41.715">really </span>
                <span begin="00:00:41.715" end="00:00:42.044">my </span>
                <span begin="00:00:42.044" end="00:00:42.444">war</span>
                <span ttm:role="x-translation">这首歌寄寓着希望 也代表着我的战斗已经打响</span>
            </p>
            <p begin="00:00:43.036" end="00:00:44.419">
                <span begin="00:00:43.036" end="00:00:43.164">So </span>
                <span begin="00:00:43.164" end="00:00:43.315">listen </span>
                <span begin="00:00:43.315" end="00:00:43.459">when </span>
                <span begin="00:00:43.459" end="00:00:43.676">the </span>
                <span begin="00:00:43.676" end="00:00:43.890">birds </span>
                <span begin="00:00:43.890" end="00:00:44.132">are </span>
                <span begin="00:00:44.132" end="00:00:44.419">singing</span>
                <span ttm:role="x-translation">所以静静聆听吧 在鸟儿鸣唱之时</span>
            </p>
            <p begin="00:00:44.643" end="00:00:45.299">
                <span begin="00:00:44.643" end="00:00:44.794">Birth </span>
                <span begin="00:00:44.794" end="00:00:45.042">that&apos;s </span>
                <span begin="00:00:45.042" end="00:00:45.299">given</span>
                <span ttm:role="x-translation">在新生命降临之时</span>
            </p>
            <p begin="00:00:45.627" end="00:00:47.442">
                <span begin="00:00:45.627" end="00:00:45.801">Seasons </span>
                <span begin="00:00:45.801" end="00:00:46.042">that </span>
                <span begin="00:00:46.042" end="00:00:46.393">change </span>
                <span begin="00:00:46.393" end="00:00:46.626">&apos;cause </span>
                <span begin="00:00:46.626" end="00:00:46.913">earth </span>
                <span begin="00:00:46.913" end="00:00:47.201">is </span>
                <span begin="00:00:47.201" end="00:00:47.442">living</span>
                <span ttm:role="x-translation">四季会更替是因为地球的生生不息</span>
            </p>
            <p begin="00:00:47.793" end="00:00:47.969">
                <span begin="00:00:47.793" end="00:00:47.969">Yeah</span>
                <span ttm:role="x-translation">//</span>
            </p>
            <p begin="00:00:48.273" end="00:00:50.146">
                <span begin="00:00:48.273" end="00:00:48.426">We </span>
                <span begin="00:00:48.426" end="00:00:48.659">take </span>
                <span begin="00:00:48.659" end="00:00:48.867">granted </span>
                <span begin="00:00:48.867" end="00:00:49.058">of </span>
                <span begin="00:00:49.058" end="00:00:49.337">this </span>
                <span begin="00:00:49.337" end="00:00:49.793">simplest </span>
                <span begin="00:00:49.793" end="00:00:50.146">beauty</span>
                <span ttm:role="x-translation">我们并没有把这最简单的美好当回事 为了新的一代</span>
            </p>
            <p begin="00:00:50.369" end="00:00:53.042">
                <span begin="00:00:50.369" end="00:00:50.529">For </span>
                <span begin="00:00:50.529" end="00:00:50.715">the </span>
                <span begin="00:00:50.715" end="00:00:50.939">new </span>
                <span begin="00:00:50.939" end="00:00:51.114">seeds </span>
                <span begin="00:00:51.114" end="00:00:51.339">I </span>
                <span begin="00:00:51.339" end="00:00:51.610">rap </span>
                <span begin="00:00:51.610" end="00:00:51.945">this </span>
                <span begin="00:00:51.945" end="00:00:52.500">intellect </span>
                <span begin="00:00:52.500" end="00:00:53.042">music</span>
                <span ttm:role="x-translation">我歌唱这首唤醒人们理智思考的歌曲</span>
            </p>
            <p begin="00:00:53.635" end="00:00:55.027">
                <span begin="00:00:53.635" end="00:00:53.989">Another </span>
                <span begin="00:00:53.989" end="00:00:54.323">dawn </span>
                <span begin="00:00:54.323" end="00:00:54.579">after </span>
                <span begin="00:00:54.579" end="00:00:54.764">sun&apos;s </span>
                <span begin="00:00:54.764" end="00:00:55.027">down</span>
                <span ttm:role="x-translation">落日西沉后又是一个破晓的黎明</span>
            </p>
            <p begin="00:00:55.348" end="00:00:56.390">
                <span begin="00:00:55.348" end="00:00:55.564">Waking </span>
                <span begin="00:00:55.564" end="00:00:55.739">with </span>
                <span begin="00:00:55.739" end="00:00:55.964">a </span>
                <span begin="00:00:55.964" end="00:00:56.163">gun </span>
                <span begin="00:00:56.163" end="00:00:56.390">sound</span>
                <span ttm:role="x-translation">被一声枪响惊醒</span>
            </p>
            <p begin="00:00:56.614" end="00:00:57.692">
                <span begin="00:00:56.614" end="00:00:56.797">No </span>
                <span begin="00:00:56.797" end="00:00:56.979">one&apos;s </span>
                <span begin="00:00:56.979" end="00:00:57.204">having </span>
                <span begin="00:00:57.204" end="00:00:57.420">fun </span>
                <span begin="00:00:57.420" end="00:00:57.692">now</span>
                <span ttm:role="x-translation">笑容逝去</span>
            </p>
            <p begin="00:00:57.956" end="00:00:58.966">
                <span begin="00:00:57.956" end="00:00:58.156">Kids </span>
                <span begin="00:00:58.156" end="00:00:58.332">crying &quot;</span>
                <span begin="00:00:58.332" end="00:00:58.613">mom&quot; </span>
                <span begin="00:00:58.613" end="00:00:58.966">loud</span>
                <span ttm:role="x-translation">现在小孩大声哭喊着 妈妈</span>
            </p>
            <p begin="00:00:59.600" end="00:01:01.257">
                <span begin="00:00:59.600" end="00:00:59.937">Brightest </span>
                <span begin="00:00:59.937" end="00:01:00.168">stars </span>
                <span begin="00:01:00.168" end="00:01:00.315">in </span>
                <span begin="00:01:00.315" end="00:01:00.569">a </span>
                <span begin="00:01:00.569" end="00:01:00.914">darkest </span>
                <span begin="00:01:00.914" end="00:01:01.257">night</span>
                <span ttm:role="x-translation">最璀璨的星辰闪耀在最黑暗的夜晚</span>
            </p>
            <p begin="00:01:01.521" end="00:01:03.153">
                <span begin="00:01:01.521" end="00:01:01.690">When </span>
                <span begin="00:01:01.690" end="00:01:01.866">I&apos;m </span>
                <span begin="00:01:01.866" end="00:01:02.024">losing </span>
                <span begin="00:01:02.024" end="00:01:02.226">it </span>
                <span begin="00:01:02.226" end="00:01:02.402">I </span>
                <span begin="00:01:02.402" end="00:01:02.611">target </span>
                <span begin="00:01:02.611" end="00:01:02.905">the </span>
                <span begin="00:01:02.905" end="00:01:03.153">mic</span>
                <span ttm:role="x-translation">当我迷茫的时候 我会拿起麦克风</span>
            </p>
            <p begin="00:01:03.497" end="00:01:03.756">
                <span begin="00:01:03.497" end="00:01:03.600">Come </span>
                <span begin="00:01:03.600" end="00:01:03.756">on</span>
                <span ttm:role="x-translation">//</span>
            </p>
            <p begin="00:01:04.180" end="00:01:06.419">
                <span begin="00:01:04.180" end="00:01:04.532">Green </span>
                <span begin="00:01:04.532" end="00:01:04.901">trees </span>
                <span begin="00:01:04.901" end="00:01:05.235">white </span>
                <span begin="00:01:05.235" end="00:01:05.581">waves </span>
                <span begin="00:01:05.581" end="00:01:05.899">yellow </span>
                <span begin="00:01:05.899" end="00:01:06.419">sunlight</span>
                <span ttm:role="x-translation">葱葱绿树 层层白浪闪耀着阳光金色的光辉</span>
            </p>
            <p begin="00:01:06.495" end="00:01:09.009">
                <span begin="00:01:06.495" end="00:01:06.845">Clear </span>
