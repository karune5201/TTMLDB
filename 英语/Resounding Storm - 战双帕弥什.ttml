<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/itunes/ttml">
  <body>
    <div>
      <p begin="00:00:01.051" end="00:00:01.809"><span begin="00:00:01.051" end="00:00:01.203">作</span><span begin="00:00:01.203" end="00:00:01.508">曲: </span><span begin="00:00:01.508" end="00:00:01.660">Ghost </span><span begin="00:00:01.660" end="00:00:01.809">Final</span><span ttm:role="x-translation">以下歌词翻译由文曲大模型提供</span></p>
      <p begin="00:00:01.809" end="00:00:02.921"><span begin="00:00:01.809" end="00:00:01.910">作</span><span begin="00:00:01.910" end="00:00:02.315">词: </span><span begin="00:00:02.315" end="00:00:02.414">Carolin </span><span begin="00:00:02.414" end="00:00:02.769">&apos;Wønder&apos; </span><span begin="00:00:02.769" end="00:00:02.921">Mrugala</span><span ttm:role="x-translation">//</span></p>
      <p begin="00:00:02.921" end="00:00:03.631"><span begin="00:00:02.921" end="00:00:03.022">演</span><span begin="00:00:03.022" end="00:00:03.276">唱: </span><span begin="00:00:03.276" end="00:00:03.428">Carolin </span><span begin="00:00:03.428" end="00:00:03.529">&apos;Wønder&apos; </span><span begin="00:00:03.529" end="00:00:03.631">Mrugala</span><span ttm:role="x-translation">//</span></p>
      <p begin="00:00:03.631" end="00:00:04.844"><span begin="00:00:03.631" end="00:00:03.781">制</span><span begin="00:00:03.781" end="00:00:03.884">片: </span><span begin="00:00:03.884" end="00:00:04.037">库</span><span begin="00:00:04.037" end="00:00:04.492">洛</span><span begin="00:00:04.492" end="00:00:04.694">游</span><span begin="00:00:04.694" end="00:00:04.844">戏</span><span ttm:role="x-translation">//</span></p>
      <p begin="00:00:04.844" end="00:00:06.975"><span begin="00:00:04.844" end="00:00:05.049">歌</span><span begin="00:00:05.049" end="00:00:05.150">词</span><span begin="00:00:05.150" end="00:00:05.303">来</span><span begin="00:00:05.303" end="00:00:05.455">源：</span><span begin="00:00:05.455" end="00:00:05.605">b</span><span begin="00:00:05.605" end="00:00:05.707">站</span><span begin="00:00:05.707" end="00:00:05.858">圣</span><span begin="00:00:05.858" end="00:00:05.962">音</span><span begin="00:00:05.962" end="00:00:06.114">流</span><span begin="00:00:06.114" end="00:00:06.975">歌</span><span ttm:role="x-translation">//</span></p>
      <p begin="00:00:23.496" end="00:00:25.976"><span begin="00:00:23.496" end="00:00:23.698">All </span><span begin="00:00:23.698" end="00:00:23.848">alone </span><span begin="00:00:23.848" end="00:00:24.102">in </span><span begin="00:00:24.102" end="00:00:24.758">the </span><span begin="00:00:24.758" end="00:00:25.976">night</span><span ttm:role="x-translation">独处在这漫漫长夜</span></p>
      <p begin="00:00:25.976" end="00:00:28.813"><span begin="00:00:25.976" end="00:00:26.332">Dark </span><span begin="00:00:26.332" end="00:00:27.092">thoughts </span><span begin="00:00:27.092" end="00:00:27.447">on </span><span begin="00:00:27.447" end="00:00:27.800">my </span><span begin="00:00:27.800" end="00:00:28.813">mind</span><span ttm:role="x-translation">黑暗思绪萦绕心头</span></p>
      <p begin="00:00:28.813" end="00:00:34.572"><span begin="00:00:28.813" end="00:00:29.214">Paint </span><span begin="00:00:29.214" end="00:00:29.719">the </span><span begin="00:00:29.719" end="00:00:30.073">dawn </span><span begin="00:00:30.073" end="00:00:30.529">across </span><span begin="00:00:30.529" end="00:00:31.084">the </span><span begin="00:00:31.084" end="00:00:33.358">silent,heartless </span><span begin="00:00:33.358" end="00:00:34.572">sky</span><span ttm:role="x-translation">将黎明涂抹在寂静无情的苍穹</span></p>
      <p begin="00:00:34.572" end="00:00:37.306"><span begin="00:00:34.572" end="00:00:35.129">I&apos;ve </span><span begin="00:00:35.129" end="00:00:35.433">made </span><span begin="00:00:35.433" end="00:00:35.837">my </span><span begin="00:00:35.837" end="00:00:36.092">choice </span><span begin="00:00:36.092" end="00:00:37.306">now</span><span ttm:role="x-translation">此刻我已做出抉择</span></p>
      <p begin="00:00:37.306" end="00:00:44.542"><span begin="00:00:37.306" end="00:00:37.862">Heavy </span><span begin="00:00:37.862" end="00:00:38.167">heart </span><span begin="00:00:38.167" end="00:00:38.724">can </span><span begin="00:00:38.724" end="00:00:39.231">finally </span><span begin="00:00:39.231" end="00:00:39.735">rest </span><span begin="00:00:39.735" end="00:00:40.392">as </span><span begin="00:00:40.392" end="00:00:40.949">I </span><span begin="00:00:40.949" end="00:00:41.406">break </span><span begin="00:00:41.406" end="00:00:41.910">my </span><span begin="00:00:41.910" end="00:00:44.542">chains</span><span ttm:role="x-translation">挣脱枷锁 沉重的心终得安歇</span></p>
      <p begin="00:00:44.542" end="00:00:49.236"><span begin="00:00:44.542" end="00:00:44.793">Those </span><span begin="00:00:44.793" end="00:00:45.096">weary </span><span begin="00:00:45.096" end="00:00:46.256">eyes, </span><span begin="00:00:46.256" end="00:00:46.760">though </span><span begin="00:00:46.760" end="00:00:47.315">fair </span><span begin="00:00:47.315" end="00:00:47.671">like </span><span begin="00:00:47.671" end="00:00:48.026">ice </span><span begin="00:00:48.026" end="00:00:48.279">and </span><span begin="00:00:48.279" end="00:00:49.236">blood</span><span ttm:role="x-translation">那双疲惫眼眸 虽如冰血般冷冽</span></p>
      <p begin="00:00:49.236" end="00:00:55.462"><span begin="00:00:49.236" end="00:00:49.641">won&apos;t </span><span begin="00:00:49.641" end="00:00:50.096">hide </span><span begin="00:00:50.096" end="00:00:50.504">all </span><span begin="00:00:50.504" end="00:00:51.464">the </span><span begin="00:00:51.464" end="00:00:51.767">flames, </span><span begin="00:00:51.767" end="00:00:52.424">that </span><span begin="00:00:52.424" end="00:00:52.778">keep </span><span begin="00:00:52.778" end="00:00:53.284">burning </span><span begin="00:00:53.284" end="00:00:53.640">inside </span><span begin="00:00:53.640" end="00:00:55.462">me</span><span ttm:role="x-translation">却掩不住我心中燃烧的烈焰</span></p>
      <p begin="00:00:55.462" end="00:01:00.318"><span begin="00:00:55.462" end="00:00:55.817">There&apos;ll </span><span begin="00:00:55.817" end="00:00:56.172">come </span><span begin="00:00:56.172" end="00:00:56.575">a </span><span begin="00:00:56.575" end="00:00:57.535">day, </span><span begin="00:00:57.535" end="00:00:57.889">I&apos;ll </span><span begin="00:00:57.889" end="00:00:58.345">stand </span><span begin="00:00:58.345" end="00:00:58.852">before </span><span begin="00:00:58.852" end="00:00:59.507">my </span><span begin="00:00:59.507" end="00:01:00.318">fear</span><span ttm:role="x-translation">终有一日 我将直面恐惧</span></p>
      <p begin="00:01:00.318" end="00:01:09.129"><span begin="00:01:00.318" end="00:01:00.775">My </span><span begin="00:01:00.775" end="00:01:01.179">shadow </span><span begin="00:01:01.179" end="00:01:01.837">though </span><span begin="00:01:01.837" end="00:01:02.292">faint </span><span begin="00:01:02.292" end="00:01:02.747">shall </span><span begin="00:01:02.747" end="00:01:03.608">draw </span><span begin="00:01:03.608" end="00:01:04.062">near </span><span begin="00:01:04.062" end="00:01:04.724">and </span><span begin="00:01:04.724" end="00:01:09.129">resound</span><span ttm:role="x-translation">我微弱的身影终将靠近并回响</span></p>
      <p begin="00:01:09.129" end="00:01:14.699"><span begin="00:01:09.129" end="00:01:09.787">Fierce </span><span begin="00:01:09.787" end="00:01:10.547">like </span><span begin="00:01:10.547" end="00:01:11.156">thunder </span><span begin="00:01:11.156" end="00:01:11.713">I&apos;ll </span><span begin="00:01:11.713" end="00:01:12.321">sunder </span><span begin="00:01:12.321" end="00:01:13.127">through </span><span begin="00:01:13.127" end="00:01:14.699">heavens</span><span ttm:role="x-translation">如雷霆般猛烈 我将撕裂苍穹</span></p>
      <p begin="00:01:14.699" end="00:01:21.127"><span begin="00:01:14.699" end="00:01:15.256">Shatter </span><span begin="00:01:15.256" end="00:01:15.764">the </span><span begin="00:01:15.764" end="00:01:16.371">iron, </span><span begin="00:01:16.371" end="00:01:17.183">defying </span><span begin="00:01:17.183" end="00:01:17.839">what </span><span begin="00:01:17.839" end="00:01:18.649">bound </span><span begin="00:01:18.649" end="00:01:21.127">me</span><span ttm:role="x-translation">击碎铁链 挣脱束缚我的枷锁</span></p>
      <p begin="00:01:21.127" end="00:01:25.576"><span begin="00:01:21.127" end="00:01:21.685">Soon </span><span begin="00:01:21.685" end="00:01:22.290">I&apos;ll, </span><span begin="00:01:22.290" end="00:01:22.847">let </span><span begin="00:01:22.847" end="00:01:23.148">my </span><span begin="00:01:23.148" end="00:01:23.553">blade </span><span begin="00:01:23.553" end="00:01:24.008">roar </span><span begin="00:01:24.008" end="00:01:24.513">with </span><span begin="00:01:24.513" end="00:01:25.576">rumble</span><span ttm:role="x-translation">很快 我将让利刃咆哮轰鸣</span></p>
      <p begin="00:01:25.576" end="00:01:35.543"><span begin="00:01:25.576" end="00:01:26.535">No </span><span begin="00:01:26.535" end="00:01:27.695">hesitations </span><span begin="00:01:27.695" end="00:01:29.115">I&apos;ll </span><span begin="00:01:29.115" end="00:01:29.724">cut </span><span begin="00:01:29.724" end="00:01:30.177">through </span><span begin="00:01:30.177" end="00:01:30.731">what&apos;s </span><span begin="00:01:30.731" end="00:01:31.036">in </span><span begin="00:01:31.036" end="00:01:31.437">my </span><span begin="00:01:31.437" end="00:01:35.543">way</span><span ttm:role="x-translation">不再犹豫 斩断前路一切阻碍</span></p>
      <p begin="00:01:45.514" end="00:01:50.779"><span begin="00:01:45.514" end="00:01:45.766">Through </span><span begin="00:01:45.766" end="00:01:46.021">the </span><span begin="00:01:46.021" end="00:01:46.325">fear </span><span begin="00:01:46.325" end="00:01:46.778">and </span><span begin="00:01:46.778" end="00:01:48.046">despair, </span><span begin="00:01:48.046" end="00:01:48.551">burning </span><span begin="00:01:48.551" end="00:01:48.805">pain </span><span begin="00:01:48.805" end="00:01:49.159">and </span><span begin="00:01:49.159" end="00:01:50.779">mistakes</span><span ttm:role="x-translation">穿越恐惧与绝望 燃烧的痛与错</span></p>
      <p begin="00:01:50.779" end="00:01:56.498"><span begin="00:01:50.779" end="00:01:51.134">Truth&apos;s </span><span begin="00:01:51.134" end="00:01:52.094">illusion </span><span begin="00:01:52.094" end="00:01:52.753">fell </span><span begin="00:01:52.753" end="00:01:53.108">to </span><span begin="00:01:53.108" end="00:01:53.918">ruin, </span><span begin="00:01:53.918" end="00:01:54.527">I </span><span begin="00:01:54.527" end="00:01:55.083">can </span><span begin="00:01:55.083" end="00:01:56.498">see</span><span ttm:role="x-translation">真相的幻象已然崩塌 我终于看清</span></p>
      <p begin="00:01:56.498" end="00:01:59.285"><span begin="00:01:56.498" end="00:01:57.258">Suddenly </span><span begin="00:01:57.258" end="00:01:57.764">I </span><span begin="00:01:57.764" end="00:01:58.119">feel </span><span begin="00:01:58.119" end="00:01:59.285">my</span><span ttm:role="x-translation">突然间我感受到</span></p>
      <p begin="00:01:59.285" end="00:02:06.626"><span begin="00:01:59.285" end="00:01:59.893">Iron </span><span begin="00:01:59.893" end="00:02:00.398">shackles </span><span begin="00:02:00.398" end="00:02:01.160">falling </span><span begin="00:02:01.160" end="00:02:02.020">down </span><span begin="00:02:02.020" end="00:02:02.575">I </span><span begin="00:02:02.575" end="00:02:03.082">can </span><span begin="00:02:03.082" end="00:02:03.436">breathe </span><span begin="00:02:03.436" end="00:02:06.626">again</span><span ttm:role="x-translation">铁链坠落 我重获呼吸自由</span></p>
      <p begin="00:02:06.626" end="00:02:11.029"><span begin="00:02:06.626" end="00:02:06.877">Those </span><span begin="00:02:06.877" end="00:02:07.283">weary </span><span begin="00:02:07.283" end="00:02:08.293">eyes, </span><span begin="00:02:08.293" end="00:02:08.698">though </span><span begin="00:02:08.698" end="00:02:09.355">fair </span><span begin="00:02:09.355" end="00:02:09.963">like </span><span begin="00:02:09.963" end="00:02:10.318">ice </span><span begin="00:02:10.318" end="00:02:10.673">and </span><span begin="00:02:10.673" end="00:02:11.029">blood</span><span ttm:role="x-translation">那双疲惫眼眸 虽如冰血般冷冽</span></p>
      <p begin="00:02:11.029" end="00:02:17.400"><span begin="00:02:11.029" end="00:02:11.685">won&apos;t </span><span begin="00:02:11.685" end="00:02:12.241">hide </span><span begin="00:02:12.241" end="00:02:13.153">all </span><span begin="00:02:13.153" end="00:02:13.508">the </span><span begin="00:02:13.508" end="00:02:14.267">flames, </span><span begin="00:02:14.267" end="00:02:14.672">that </span><span begin="00:02:14.672" end="00:02:15.179">keep </span><span begin="00:02:15.179" end="00:02:15.531">burning </span><span begin="00:02:15.531" end="00:02:15.784">inside </span><span begin="00:02:15.784" end="00:02:17.400">me</span><span ttm:role="x-translation">却掩不住我心中燃烧的烈焰</span></p>
      <p begin="00:02:17.400" end="00:02:22.303"><span begin="00:02:17.400" end="00:02:17.804">There&apos;ll </span><span begin="00:02:17.804" end="00:02:18.211">come </span><span begin="00:02:18.211" end="00:02:18.614">a </span><span begin="00:02:18.614" end="00:02:19.526">day, </span><span begin="00:02:19.526" end="00:02:19.928">I&apos;ll </span><span begin="00:02:19.928" end="00:02:20.535">stand </span><span begin="00:02:20.535" end="00:02:20.991">before </span><span begin="00:02:20.991" end="00:02:21.445">my </span><span begin="00:02:21.445" end="00:02:22.303">fear</span><span ttm:role="x-translation">终有一日 我将直面恐惧</span></p>
      <p begin="00:02:22.303" end="00:02:31.313"><span begin="00:02:22.303" end="00:02:22.758">My </span><span begin="00:02:22.758" end="00:02:23.111">shadow </span><span begin="00:02:23.111" end="00:02:24.124">though </span><span begin="00:02:24.124" end="00:02:24.531">faint </span><span begin="00:02:24.531" end="00:02:25.036">shall </span><span begin="00:02:25.036" end="00:02:25.594">draw </span><span begin="00:02:25.594" end="00:02:25.999">near </span><span begin="00:02:25.999" end="00:02:26.505">and </span><span begin="00:02:26.505" end="00:02:31.313">resound</span><span ttm:role="x-translation">我微弱的身影终将靠近并回响</span></p>
      <p begin="00:02:31.313" end="00:02:36.519"><span begin="00:02:31.313" end="00:02:31.717">Fierce </span><span begin="00:02:31.717" end="00:02:32.427">like </span><span begin="00:02:32.427" end="00:02:32.931">thunder </span><span begin="00:02:32.931" end="00:02:33.635">I&apos;ll </span><span begin="00:02:33.635" end="00:02:34.040">sunder </span><span begin="00:02:34.040" end="00:02:34.495">through </span><span begin="00:02:34.495" end="00:02:36.519">heavens</span><span ttm:role="x-translation">如雷霆般猛烈 我将撕裂苍穹</span></p>
      <p begin="00:02:36.519" end="00:02:42.849"><span begin="00:02:36.519" end="00:02:37.075">Shatter </span><span begin="00:02:37.075" end="00:02:37.682">the </span><span begin="00:02:37.682" end="00:02:38.644">iron, </span><span begin="00:02:38.644" end="00:02:39.455">defying </span><span begin="00:02:39.455" end="00:02:40.265">what </span><span begin="00:02:40.265" end="00:02:40.772">bound </span><span begin="00:02:40.772" end="00:02:42.849">me</span><span ttm:role="x-translation">击碎铁链 挣脱束缚我的枷锁</span></p>
      <p begin="00:02:42.849" end="00:02:47.757"><span begin="00:02:42.849" end="00:02:43.559">Soon </span><span begin="00:02:43.559" end="00:02:44.316">I&apos;ll, </span><span begin="00:02:44.316" end="00:02:44.872">let </span><span begin="00:02:44.872" end="00:02:45.175">my </span><span begin="00:02:45.175" end="00:02:45.578">blade </span><span begin="00:02:45.578" end="00:02:46.137">roar </span><span begin="00:02:46.137" end="00:02:46.644">with </span><span begin="00:02:46.644" end="00:02:47.757">rumble</span><span ttm:role="x-translation">很快 我将让利刃咆哮轰鸣</span></p>
      <p begin="00:02:47.757" end="00:02:54.692"><span begin="00:02:47.757" end="00:02:48.319">No </span><span begin="00:02:48.319" end="00:02:49.383">hesitations </span><span begin="00:02:49.383" end="00:02:49.936">I&apos;ll </span><span begin="00:02:49.936" end="00:02:51.455">finally </span><span begin="00:02:51.455" end="00:02:52.518">know </span><span begin="00:02:52.518" end="00:02:53.023">my </span><span begin="00:02:53.023" end="00:02:54.692">way</span><span ttm:role="x-translation">不再犹豫 终将看清前路</span></p>
      <p begin="00:02:54.692" end="00:02:59.191"><span begin="00:02:54.692" end="00:02:55.048">Fierce </span><span begin="00:02:55.048" end="00:02:55.400">like </span><span begin="00:02:55.400" end="00:02:55.957">thunder </span><span begin="00:02:55.957" end="00:02:56.512">I&apos;ll </span><span begin="00:02:56.512" end="00:02:57.172">sunder </span><span begin="00:02:57.172" end="00:02:57.728">through </span><span begin="00:02:57.728" end="00:02:59.191">heavens</span><span ttm:role="x-translation">如雷霆般猛烈 我将撕裂苍穹</span></p>
      <p begin="00:02:59.191" end="00:03:05.468"><span begin="00:02:59.191" end="00:02:59.698">Dispel </span><span begin="00:02:59.698" end="00:03:00.252">the </span><span begin="00:03:00.252" end="00:03:01.469">darkness </span><span begin="00:03:01.469" end="00:03:02.329">I&apos;ll </span><span begin="00:03:02.329" end="00:03:02.735">fight </span><span begin="00:03:02.735" end="00:03:03.190">it </span><span begin="00:03:03.190" end="00:03:05.468">forever</span><span ttm:role="x-translation">驱散黑暗 永世抗争</span></p>
      <p begin="00:03:05.468" end="00:03:10.222"><span begin="00:03:05.468" end="00:03:06.023">Now </span><span begin="00:03:06.023" end="00:03:06.529">I </span><span begin="00:03:06.529" end="00:03:06.984">feel </span><span begin="00:03:06.984" end="00:03:07.288">my </span><span begin="00:03:07.288" end="00:03:07.894">heart </span><span begin="00:03:07.894" end="00:03:08.449">beating </span><span begin="00:03:08.449" end="00:03:10.222">louder</span><span ttm:role="x-translation">此刻心跳如擂鼓震耳</span></p>
      <p begin="00:03:10.977" end="00:06:54.768"><span begin="00:03:10.977" end="00:03:11.332">Leap </span><span begin="00:03:11.332" end="00:03:11.686">to </span><span begin="00:03:11.686" end="00:03:12.092">the </span><span begin="00:03:12.092" end="00:03:13.155">future, </span><span begin="00:03:13.155" end="00:03:13.560">I </span><span begin="00:03:13.560" end="00:03:14.166">finally </span><span begin="00:03:14.166" end="00:03:15.228">fear </span><span begin="00:03:15.228" end="00:03:15.934">no </span><span begin="00:03:15.934" end="00:06:54.768">pain</span><span ttm:role="x-translation">跃向未来 再无惧痛楚</span></p>
    </div>
  </body>
</tt>